API_BASE_URL=http://host.docker.internal:8787
API_BASE_URL_FALLBACKS=
API_KEY=local-dev-task-api-key
NODE_ID=
NODE_NAME=local-docker-node
NODE_TYPE=docker
POLL_INTERVAL_SECONDS=3
HEARTBEAT_INTERVAL_SECONDS=30

# Local simulation capabilities (no cloud required)
CAPABILITIES=contract_review,payment_risk_assessment,approval_ai_gate,reimbursement_check,reimbursement_anomaly,log_smart_fill,log_analysis,log_summary,ocr_extract,equipment_recommend,consumable_estimation,inventory_alert_analysis,consumption_anomaly,file_generate

# true: force local mock provider only; false: use Claude when ANTHROPIC_API_KEY exists
MOCK_AI_ONLY=true

# Optional TLS/mTLS
TLS_CA_CERT_PATH=
TLS_CLIENT_CERT_PATH=
TLS_CLIENT_KEY_PATH=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
