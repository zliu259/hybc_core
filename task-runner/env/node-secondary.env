API_BASE_URL=http://host.docker.internal:8787
API_BASE_URL_FALLBACKS=
API_KEY=local-dev-task-api-key
NODE_ID=local-secondary-node
NODE_NAME=local-secondary-node
NODE_TYPE=docker
POLL_INTERVAL_SECONDS=3
HEARTBEAT_INTERVAL_SECONDS=30
CAPABILITIES=reimbursement_check,reimbursement_anomaly,log_smart_fill,log_summary,external_log_audit,equipment_recommend,consumable_estimation,inventory_alert_analysis,consumption_anomaly,ocr_extract,file_generate
MOCK_AI_ONLY=false
TLS_CA_CERT_PATH=/certs/ca.crt
TLS_CLIENT_CERT_PATH=/certs/secondary.crt
TLS_CLIENT_KEY_PATH=/certs/secondary.key
OPENAI_API_KEY=
