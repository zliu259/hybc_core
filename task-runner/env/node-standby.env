API_BASE_URL=http://host.docker.internal:8787
API_BASE_URL_FALLBACKS=
API_KEY=local-dev-task-api-key
NODE_ID=local-standby-node
NODE_NAME=local-standby-node
NODE_TYPE=docker
POLL_INTERVAL_SECONDS=3
HEARTBEAT_INTERVAL_SECONDS=30
CAPABILITIES=approval_ai_gate,log_summary,external_log_audit,inventory_alert_analysis,consumption_anomaly,ocr_extract,file_generate
MOCK_AI_ONLY=false
TLS_CA_CERT_PATH=/certs/ca.crt
TLS_CLIENT_CERT_PATH=/certs/standby.crt
TLS_CLIENT_KEY_PATH=/certs/standby.key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_MODEL_OCR_EXTRACT_VISION=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
