# Node（不带斜杠:同时匹配目录与 worktree 里的 symlink）
node_modules
dist/
.npm/
package-lock.json

# Miniapp dependencies / generated vendor packages
packages/miniapp/node_modules/
packages/miniapp/miniprogram_npm/*
!packages/miniapp/miniprogram_npm/.gitkeep
packages/miniapp/tdesign-miniprogram/

# Python
__pycache__/
.pytest_cache/
.venv/

# Cloudflare local state
.wrangler/

# Env files
.env
.env.local
.dev.vars
.dev.vars.*
!.dev.vars.example

# Local service runtime data
n8n/data/

# Local brainstorming/mockup artifacts
.superpowers/

# Git worktrees (isolated workspaces)
.worktrees/

# Claude Code local config & agent worktrees
# .claude/worktrees/ 是独立 git 检出（含历史代码副本，可能带明文密钥），绝不入父仓库；
# settings.local.json / launch.json 是机器本地配置；.mcp.json 是本机 MCP 接入配置。
# 如需与团队共享 skills/agents，可对具体子目录用 !.claude/skills 白名单放行。
.claude/
.mcp.json

# Local DB backups (do NOT commit production data dumps)
backups/

# OS/editor
.DS_Store
.idea/
.vscode/

# 旧系统迁移工作目录（含银行账号等敏感数据，勿入库）
/mig/
