{
  "name": "@hybc/mcp",
  "version": "0.1.0",
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "type": "module",
  "bin": {
    "hybc-mcp": "./dist/cli.js"
  },
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/hybc-mcp.mjs",
    "publish:dist": "node scripts/publish-dist.mjs .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
