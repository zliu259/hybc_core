.top-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.status-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin: 8rpx 0 16rpx;
}

.label {
  margin-top: 14rpx;
  margin-bottom: 8rpx;
  color: #4b5563;
  font-size: 28rpx;
}

.input,
.picker-value,
.textarea {
  width: 100%;
  background: #fff;
  border: 1rpx solid #d7dbe3;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.picker-value {
  color: #1f2937;
}

.textarea {
  min-height: 140rpx;
}

.row {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.btn {
  flex: 1;
}

.attachment-empty {
  color: #7b8494;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.attachment-item {
  margin-top: 12rpx;
  padding: 14rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fff;
}

.attachment-main {
  margin-bottom: 8rpx;
}

.attachment-name {
  color: #111827;
  font-size: 26rpx;
  word-break: break-all;
}

.attachment-meta {
  color: #6b7280;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.attachment-actions {
  display: flex;
  gap: 12rpx;
}
