<view class="page">
  <view class="card">
    <view class="title">信封扫码填报</view>
    <view class="label">信封UUID</view>
    <input class="input" value="{{scan.envelope_uuid}}" data-key="envelope_uuid" bindinput="onScanInput" />
    <view class="label">项目ID</view>
    <input class="input" type="number" value="{{scan.project_id}}" data-key="project_id" bindinput="onScanInput" />
    <view class="label">发票号</view>
    <input class="input" value="{{scan.invoice_no}}" data-key="invoice_no" bindinput="onScanInput" />
    <view class="label">金额</view>
    <input class="input" type="digit" value="{{scan.amount}}" data-key="amount" bindinput="onScanInput" />
    <view class="row">
      <button class="btn" bindtap="scanQr">扫码识别</button>
      <button class="btn" type="primary" bindtap="submitScan">提交填报</button>
    </view>
  </view>

  <view class="card">
    <view class="title">电子发票拍照上传(OCR)</view>
    <view class="label">项目ID</view>
    <input class="input" type="number" value="{{invoice.project_id}}" data-key="project_id" bindinput="onInvoiceInput" />
    <view class="label">发票号（可选）</view>
    <input class="input" value="{{invoice.invoice_no}}" data-key="invoice_no" bindinput="onInvoiceInput" />
    <view class="row">
      <button class="btn" bindtap="pickInvoicePhoto">拍照上传</button>
      <button class="btn" bindtap="refreshOcrStatus">刷新OCR状态</button>
    </view>
    <view class="sub">OCR状态: {{ocrStatus}}</view>
  </view>

  <view class="card">
    <view class="title">生成报销信封PDF</view>
    <view class="label">信封ID</view>
    <input class="input" type="number" value="{{pdfEnvelopeId}}" bindinput="onPdfIdInput" />
    <view class="row">
      <button class="btn" bindtap="generatePdf">触发PDF</button>
      <button class="btn" bindtap="refreshPdfStatus">刷新PDF状态</button>
    </view>
    <view class="sub">PDF状态: {{pdfStatus}}</view>
  </view>
</view>
