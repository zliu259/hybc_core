<view class="page">
  <hy-panel-card title="🧾 报销提交详情" subtitle="与 Web 个人报销对齐：草稿、附件、提交、状态追踪">
    <view class="top-actions">
      <t-button class="btn" variant="outline" bindtap="goMyList">返回我的提交</t-button>
      <t-button class="btn" variant="outline" bindtap="resetDraft" disabled="{{busy}}">新建草稿</t-button>
    </view>

    <view class="status-grid">
      <hy-status-chip text="报销ID：{{latestEnvelopeId || '-'}}" theme="warning" variant="light" />
      <hy-status-chip text="识别号：{{latestEnvelopeNo || latestEnvelopeUuid || '-'}}" theme="success" variant="light" />
      <hy-status-chip text="状态：{{latestEnvelopeStatusText}}" theme="warning" variant="light" />
      <hy-status-chip text="核验：{{verificationStatusText}}" theme="success" variant="light" />
      <hy-status-chip text="预审：{{precheckStatusText}}" theme="warning" variant="light" />
      <hy-status-chip text="PDF：{{pdfStatusText}}" theme="success" variant="light" />
      <hy-status-chip text="附件数：{{attachmentCount}}" theme="success" variant="light" />
      <hy-status-chip text="OCR：{{ocrStatusText}}" theme="warning" variant="light" />
      <hy-status-chip text="批次：{{batchInfoText}}" theme="warning" variant="light" />
    </view>

    <t-notice-bar content="建议流程：实物信封需先扫码/输入UUID再保存草稿；上传附件会立即进入审计。电子发票上传后自动进入办公室核查流程。" theme="warning" />

    <hy-project-picker value="{{sharedProjectId}}" label="所属项目" enableGps="{{false}}" bind:change="onProjectChange" />

    <view class="label">报销通道</view>
    <picker mode="selector" range="{{channelOptions}}" range-key="label" value="{{channelIndex}}" bindchange="onChannelChange">
      <view class="picker-value">{{channelOptions[channelIndex].label}}</view>
    </picker>

    <view class="label">绑定信封 UUID（可选）</view>
    <input class="input" value="{{draft.preferred_envelope_uuid}}" data-key="preferred_envelope_uuid" bindinput="onDraftInput" disabled="{{busy}}" placeholder="扫码或粘贴 UUID" />

    <view class="label">发票号（可选）</view>
    <input class="input" value="{{draft.invoice_no}}" data-key="invoice_no" bindinput="onDraftInput" disabled="{{busy}}" />

    <view class="label">费用日期（可选）</view>
    <picker mode="date" value="{{draft.expense_date}}" bindchange="onDraftInput" data-key="expense_date">
      <view class="picker-value">{{draft.expense_date || '请选择日期'}}</view>
    </picker>

    <view class="label">金额（可选）</view>
    <input class="input" type="digit" value="{{draft.amount}}" data-key="amount" bindinput="onDraftInput" disabled="{{busy}}" />

    <view class="label">类别（可选）</view>
    <input class="input" value="{{draft.category}}" data-key="category" bindinput="onDraftInput" disabled="{{busy}}" />

    <view class="label">说明（可选）</view>
    <textarea class="textarea" value="{{draft.description}}" data-key="description" bindinput="onDraftInput" maxlength="240" disabled="{{busy}}" />

    <view class="row">
      <t-button class="btn" variant="outline" bindtap="scanQr" disabled="{{busy}}">📷 扫码录入UUID</t-button>
      <t-button class="btn btn-primary" theme="primary" bindtap="createOrUpdateDraft" loading="{{busy}}" disabled="{{busy}}">💾 保存草稿</t-button>
    </view>

    <view class="label">附件类型</view>
    <picker mode="selector" range="{{attachmentTypeOptions}}" range-key="label" value="{{attachmentTypeIndex}}" bindchange="onAttachmentTypeChange">
      <view class="picker-value">{{attachmentTypeOptions[attachmentTypeIndex].label}}</view>
    </picker>

    <view class="row">
      <t-button class="btn" variant="outline" bindtap="pickPhysicalInvoicePhoto" loading="{{busy}}" disabled="{{busy || !latestEnvelopeId}}">📎 上传附件(图片)</t-button>
      <t-button class="btn" variant="outline" bindtap="pickAttachmentFile" loading="{{busy}}" disabled="{{busy || !latestEnvelopeId}}">📁 上传附件(文件)</t-button>
    </view>

    <view class="row">
      <t-button class="btn" variant="outline" bindtap="pickInvoicePhoto" loading="{{busy}}" disabled="{{busy}}">📸 上传电子发票并OCR</t-button>
    </view>

    <view class="row">
      <t-button class="btn" variant="outline" bindtap="refreshOcrStatus" loading="{{busy}}" disabled="{{busy || !latestEnvelopeId}}">刷新OCR状态</t-button>
      <t-button class="btn btn-primary" theme="primary" bindtap="submitEnvelope" loading="{{busy}}" disabled="{{busy || !latestEnvelopeId || draft.channel === 'electronic'}}">📨 提交报销</t-button>
    </view>

    <view class="label">附件列表</view>
    <view wx:if="{{attachmentItems.length === 0}}" class="attachment-empty">暂无附件</view>
    <view wx:for="{{attachmentItems}}" wx:key="id" class="attachment-item">
      <view class="attachment-main">
        <view class="attachment-name">{{item.file_name}}</view>
        <view class="attachment-meta">类型：{{item.attachment_type}}</view>
      </view>
      <view class="attachment-actions">
        <t-button
          class="btn"
          size="small"
          variant="outline"
          data-url="{{item.file_url}}"
          data-image="{{item.is_image}}"
          bindtap="previewAttachment"
        >查看</t-button>
        <t-button
          class="btn"
          size="small"
          theme="primary"
          data-url="{{item.file_url}}"
          data-name="{{item.file_name}}"
          bindtap="downloadAttachment"
        >下载</t-button>
      </view>
    </view>

    <view class="label">查重线索</view>
    <view wx:if="{{duplicateChecks.length === 0}}" class="attachment-empty">暂无查重线索</view>
    <view wx:for="{{duplicateChecks}}" wx:key="id" class="duplicate-item">
      <view class="duplicate-summary">{{item.summary}}</view>
      <view class="duplicate-risk">{{item.risk}}</view>
    </view>
  </hy-panel-card>

  <view class="fab-helper" bindtap="openGlobalHelper">🎤</view>
</view>
