@import "../../styles/detail-cards.wxss";

.hero-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.card-stat {
  flex: none;
  font-size: 24rpx;
  color: #5c667a;
}

.card-empty {
  font-size: 26rpx;
  line-height: 1.55;
  color: #5c667a;
}

.retry-row {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
}

/* 执行进度 */
.progress-item {
  margin-top: 14rpx;
}

.progress-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.progress-figure {
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  color: #1f2329;
}

.progress-figure.is-over {
  color: #d54941;
}

.progress-track {
  height: 10rpx;
  margin-top: 8rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #edf1f6;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  background: #1677ff;
}

.progress-fill.is-over {
  background: #d54941;
}

.progress-remain {
  margin-top: 8rpx;
  font-size: 24rpx;
  text-align: right;
  color: #5c667a;
}

/* 付款、收款、金额变更的行 */
.record-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.card-head + .record-row {
  border-top: 0;
  padding-top: 4rpx;
}

.record-row:last-child {
  padding-bottom: 0;
}

.record-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-no {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  word-break: break-all;
}

.record-amount {
  flex: none;
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: #1f2329;
}

.record-amounts {
  margin-top: 6rpx;
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
  color: #1f2329;
}

.record-reason {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #1f2329;
  word-break: break-word;
  white-space: pre-wrap;
}

.record-sub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.record-time {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8a94a6;
}

.record-row .attach-row {
  margin-top: 8rpx;
}
