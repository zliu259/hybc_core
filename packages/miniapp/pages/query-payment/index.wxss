.stage-tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.stage-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 26rpx;
}

.stage-tab--active {
  background: #2563eb;
  color: #fff;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.input,
.picker-value {
  flex: 1;
  background: #fff;
  border: 1rpx solid #d7dbe3;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn {
  flex: 1;
}

.empty {
  text-align: center;
  color: #7b8494;
  padding: 24rpx 0;
}

.item-card {
  background: #fff;
  border: 1rpx solid #e7eaf0;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.item-no {
  font-weight: 600;
  color: #1f2937;
}

.item-chips {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.item-sub {
  color: #5c667a;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.item-amount {
  margin-top: 6rpx;
  color: #174ea6;
  font-size: 30rpx;
  font-weight: 700;
}

.item-returned {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.item-returned-text {
  color: #dc2626;
  font-size: 24rpx;
}

.pager {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pager-btn {
  width: 160rpx;
}

.pager-text {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #5c667a;
}
