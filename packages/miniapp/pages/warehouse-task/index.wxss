.task-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #24433d 0%, #2f6c5f 100%);
  box-shadow: 0 16rpx 36rpx rgba(47, 108, 95, 0.22);
}

.hero-kicker {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.76);
}

.hero-title {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.82);
}

.hero-count {
  flex: 0 0 auto;
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
}

.count-value {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 800;
}

.count-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.segment-wrap {
  display: flex;
  gap: 12rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1px solid #dbe8f7;
  margin: 18rpx 0 20rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: #55657b;
}

.segment-item.active {
  background: #2f6c5f;
  color: #fff;
  font-weight: 700;
}

.empty-state {
  padding: 34rpx 12rpx;
  text-align: center;
  color: #6b7a90;
  font-size: 24rpx;
}

.task-card {
  padding: 22rpx;
  margin-bottom: 16rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1px solid #dbe8f7;
}

.task-card:active {
  opacity: 0.84;
}

.task-head,
.detail-head,
.evidence-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.task-no {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
}

.status-chip {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef6ff;
  color: #2362a8;
  font-size: 22rpx;
}

.status-chip.in_progress {
  background: #f0fff4;
  color: #237a3b;
}

.status-chip.rejected {
  background: #fff7ea;
  color: #b26a00;
}

.task-title {
  margin-top: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2329;
}

.task-meta,
.task-remark {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.4;
  color: #6b7a90;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 30, 38, 0.42);
}

.detail-panel {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  padding: 28rpx;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
  background: #f7f9fc;
}

.detail-kicker {
  font-size: 23rpx;
  color: #5c667a;
}

.detail-title {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2329;
}

.close-btn {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #5c667a;
  font-size: 42rpx;
  line-height: 1;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
}

.detail-cell,
.section,
.evidence-row {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1px solid #dbe8f7;
}

.cell-label {
  font-size: 22rpx;
  color: #6b7a90;
}

.cell-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2329;
}

.section,
.evidence-row {
  margin-top: 16rpx;
}

.section-title {
  font-size: 27rpx;
  font-weight: 800;
  color: #1f2329;
}

.section-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #5c667a;
}

.manual-section {
  background: #eefbf3;
  border-color: #c9edd5;
}

.step-item {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.step-no {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eef6ff;
  color: #2362a8;
  font-size: 22rpx;
  font-weight: 800;
}

.step-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.48;
  color: #1f2329;
}

.result-input {
  width: 100%;
  min-height: 180rpx;
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  box-sizing: border-box;
  background: #f8fbff;
  color: #1f2329;
  font-size: 25rpx;
  line-height: 1.5;
}

.detail-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
  padding-bottom: 12rpx;
}
