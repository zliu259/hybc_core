.warehouse-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #23413a 0%, #327667 100%);
  box-shadow: 0 16rpx 36rpx rgba(45, 105, 92, 0.22);
}

.hero-kicker {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-title {
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.82);
}

.hero-count {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
}

.count-value {
  font-size: 42rpx;
  line-height: 1;
  font-weight: 800;
}

.count-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin: 18rpx 0 20rpx;
}

.summary-card {
  min-height: 128rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1px solid #dbe8f7;
  box-sizing: border-box;
}

.summary-card.warn {
  background: #fff7ea;
  border-color: #ffd99a;
}

.summary-card.ok {
  background: #f0fff4;
  border-color: #bde8c6;
}

.summary-value {
  font-size: 36rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #1f2329;
}

.summary-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #5c667a;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.action-card {
  min-height: 166rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #f8fbff;
  border: 1px solid #dbe8f7;
}

.action-card:active,
.secondary-item:active,
.priority-item:active {
  opacity: 0.82;
}

.action-card.green {
  background: #eefbf3;
  border-color: #c9edd5;
}

.action-card.blue {
  background: #eef6ff;
  border-color: #cfe3ff;
}

.action-card.orange {
  background: #fff7ea;
  border-color: #ffd99a;
}

.action-card.gray {
  background: #f6f8fb;
  border-color: #e2e8f0;
}

.action-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.action-title {
  min-width: 0;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1f2329;
}

.action-badge {
  flex: 0 0 auto;
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 800;
  color: #2f6c5f;
  background: #ffffff;
  border: 1px solid rgba(47, 108, 95, 0.2);
}

.action-desc {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #5c667a;
}

.priority-item,
.secondary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 20rpx 0;
  border-bottom: 1px solid #edf2f7;
}

.priority-item:last-child,
.secondary-item:last-child {
  border-bottom: 0;
}

.priority-main {
  flex: 1;
  min-width: 0;
}

.priority-title,
.secondary-title {
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1f2329;
}

.priority-sub,
.secondary-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #6b7a90;
}

.priority-arrow,
.secondary-arrow {
  flex: 0 0 auto;
  color: #9aa6b6;
  font-size: 42rpx;
  line-height: 1;
}

.secondary-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.secondary-count {
  min-width: 44rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b26a00;
  background: #fff7ea;
}

.empty-state {
  padding: 28rpx 12rpx;
  text-align: center;
  color: #6b7a90;
  font-size: 24rpx;
}
