.scan-row {
  margin-bottom: 20rpx;
}

.scan-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: #1677ff;
  border-radius: 16rpx;
}

.scan-button-hover,
.scan-button-busy {
  opacity: 0.75;
}

.scan-button-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.search {
  margin-bottom: 24rpx;
}

.search-input {
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background: #fff;
  border-radius: 16rpx;
}

.search-results {
  margin-top: 8rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}

.search-empty,
.section-empty {
  padding: 28rpx 24rpx;
  font-size: 26rpx;
  color: #8a94a6;
}

.search-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-top: 1rpx solid #f0f2f5;
}

.search-item:first-child {
  border-top: 0;
}

.search-item-main {
  flex: 1;
  min-width: 0;
}

.search-item-code {
  margin-right: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2a3d;
}

.search-item-name {
  font-size: 26rpx;
  color: #5c667a;
}

.search-item-state {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.load-failed {
  margin-bottom: 20rpx;
  padding: 16rpx 24rpx;
  font-size: 26rpx;
  color: #ad6800;
  background: #fff7e6;
  border-radius: 12rpx;
}

.tiles {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}

.tile {
  box-sizing: border-box;
  width: 33.33%;
  padding: 24rpx 12rpx;
  text-align: center;
}

.tile-count {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #b4bccb;
}

.tile-count-active {
  color: #1677ff;
}

.tile-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5c667a;
}

.section {
  margin-bottom: 24rpx;
  overflow: hidden;
  background: #fff;
  border-radius: 16rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.section-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2a3d;
}

.section-more {
  font-size: 26rpx;
  color: #5c667a;
}

.chevron {
  margin-left: 8rpx;
  color: #b4bccb;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-top: 1rpx solid #f0f2f5;
}

.row-hover {
  background: #f5f7fa;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  overflow: hidden;
  font-size: 28rpx;
  color: #1f2a3d;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.row-side {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.row-side-alert {
  color: #d4380d;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx 16rpx;
}

.action {
  box-sizing: border-box;
  width: calc(33.33% - 16rpx);
  margin: 8rpx;
  padding: 24rpx 8rpx;
  font-size: 26rpx;
  color: #1f2a3d;
  text-align: center;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.action-hover {
  background: #e8edf5;
}
