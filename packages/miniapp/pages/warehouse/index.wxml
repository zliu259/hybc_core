<view class="page">
  <!-- 所有人：扫一扫、搜设备 -->
  <view class="scan-row">
    <view class="scan-button {{scanning ? 'scan-button-busy' : ''}}" hover-class="scan-button-hover" bindtap="onScan">
      <text class="scan-button-text">{{scanning ? "正在打开…" : "扫一扫设备"}}</text>
    </view>
  </view>
  <view class="search">
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="输入设备编号或名称"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <view wx:if="{{searched || searchResults.length > 0}}" class="search-results">
      <view wx:if="{{searchResults.length === 0}}" class="search-empty">没有找到设备</view>
      <view
        wx:for="{{searchResults}}"
        wx:key="id"
        class="search-item"
        hover-class="row-hover"
        data-id="{{item.id}}"
        bindtap="onPickDevice"
      >
        <view class="search-item-main">
          <text class="search-item-code">{{item.code}}</text>
          <text class="search-item-name">{{item.name}}</text>
        </view>
        <text class="search-item-state">{{item.stateLabel}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loadFailed}}" class="load-failed">加载失败，下拉重试</view>

  <!-- 库管：待办数字 -->
  <view wx:if="{{view.tiles.length > 0}}" class="tiles">
    <view
      wx:for="{{view.tiles}}"
      wx:key="key"
      class="tile"
      hover-class="row-hover"
      data-url="{{item.url}}"
      bindtap="goTo"
    >
      <view class="tile-count {{item.count > 0 ? 'tile-count-active' : ''}}">{{item.count}}</view>
      <view class="tile-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 所有人：我的任务 -->
  <view class="section">
    <view
      class="section-head"
      hover-class="row-hover"
      data-url="/packageWarehouse/task-list/index?tab=mine"
      bindtap="goTo"
    >
      <text class="section-name">我的任务</text>
      <text class="section-more">{{view.myTasks.count}} 个待办<text class="chevron">›</text></text>
    </view>
    <view wx:if="{{view.myTasks.items.length === 0}}" class="section-empty">没有派给我的任务</view>
    <view
      wx:for="{{view.myTasks.items}}"
      wx:key="id"
      class="list-row"
      hover-class="row-hover"
      data-id="{{item.id}}"
      bindtap="openTask"
    >
      <view class="row-main">
        <view class="row-title">{{item.title}}</view>
        <view wx:if="{{item.deviceText}}" class="row-sub">{{item.deviceText}}</view>
      </view>
      <text wx:if="{{item.dueText}}" class="row-side {{item.overdue ? 'row-side-alert' : ''}}">{{item.dueText}}</text>
    </view>
  </view>

  <!-- 项目负责人：我的项目 -->
  <view wx:if="{{view.showProjects}}" class="section">
    <view
      class="section-head"
      hover-class="row-hover"
      data-url="/packageWarehouse/kit-list/index"
      bindtap="goTo"
    >
      <text class="section-name">我的项目</text>
      <text class="section-more">全部清单<text class="chevron">›</text></text>
    </view>
    <view wx:if="{{view.projects.length === 0}}" class="section-empty">没有我负责的项目</view>
    <view
      wx:for="{{view.projects}}"
      wx:key="projectId"
      class="list-row"
      hover-class="row-hover"
      data-id="{{item.projectId}}"
      bindtap="openProject"
    >
      <view class="row-main">
        <view class="row-title">{{item.name}}</view>
        <view class="row-sub">{{item.summary}}</view>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>

  <!-- 库管：日常动作 -->
  <view wx:if="{{view.actions.length > 0}}" class="section">
    <view class="section-head section-head-plain">
      <text class="section-name">库房动作</text>
    </view>
    <view class="actions">
      <view
        wx:for="{{view.actions}}"
        wx:key="key"
        class="action"
        hover-class="action-hover"
        data-url="{{item.url}}"
        bindtap="goTo"
      >{{item.label}}</view>
    </view>
  </view>
</view>
