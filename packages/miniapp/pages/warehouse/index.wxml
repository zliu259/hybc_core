<view class="page">
  <view class="warehouse-hero">
    <view>
      <view class="hero-kicker">移动端精简执行台</view>
      <view class="hero-title">库房执行台</view>
      <view class="hero-desc">聚焦执行人员的任务开始、证据上传、单据执行与盘库录入</view>
    </view>
    <view class="hero-count" bindtap="openGlobalHelper">
      <view class="count-value">{{kpis.myTaskCount}}</view>
      <view class="count-label">我的任务</view>
    </view>
  </view>

  <view class="summary-grid">
    <view class="summary-card">
      <view class="summary-value">{{kpis.myTaskCount}}</view>
      <view class="summary-label">待办任务</view>
    </view>
    <view class="summary-card ok">
      <view class="summary-value">{{kpis.inProgressCount}}</view>
      <view class="summary-label">执行中</view>
    </view>
    <view class="summary-card warn">
      <view class="summary-value">{{kpis.rejectedCount}}</view>
      <view class="summary-label">需补充</view>
    </view>
  </view>

  <hy-panel-card title="快速操作" icon="🛠️" subtitle="仅保留执行人员高频动作">
    <view class="action-grid">
      <view wx:for="{{actions}}" wx:key="title" class="action-card {{item.tone}}" data-path="{{item.path}}" bindtap="goTo">
        <view class="action-head">
          <view class="action-title">{{item.title}}</view>
          <view wx:if="{{item.showBadge}}" class="action-badge">{{item.count}}</view>
        </view>
        <view class="action-desc">{{item.desc}}</view>
      </view>
    </view>
  </hy-panel-card>

  <hy-panel-card title="优先处理" icon="⏰" subtitle="高优先级和退回任务会在这里提醒">
    <view wx:if="{{urgentTasks.length === 0}}" class="empty-state">暂无紧急任务</view>
    <view wx:for="{{urgentTasks}}" wx:key="id" class="priority-item" data-path="/pages/warehouse-task/index" bindtap="goTo">
      <view class="priority-main">
        <view class="priority-title">{{item.work_order_no}} · {{item.typeText}}</view>
        <view class="priority-sub">{{item.priorityText}} · {{item.statusText}} · {{item.scheduledDay}}</view>
      </view>
      <view class="priority-arrow">›</view>
    </view>
  </hy-panel-card>

  <hy-panel-card title="辅助入口" icon="📋" subtitle="低频管理动作保留入口，不进入执行主路径">
    <view class="secondary-list">
      <view wx:for="{{secondaryActions}}" wx:key="title" class="secondary-item" data-path="{{item.path}}" bindtap="goTo">
        <view>
          <view class="secondary-title">{{item.title}}</view>
          <view class="secondary-desc">{{item.desc}}</view>
        </view>
        <view class="secondary-right">
          <view wx:if="{{item.showCount}}" class="secondary-count">{{item.count}}</view>
          <view class="secondary-arrow">›</view>
        </view>
      </view>
    </view>
  </hy-panel-card>
</view>
