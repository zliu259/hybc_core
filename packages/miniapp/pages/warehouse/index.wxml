<view class="page">
  <hy-panel-card title="📦 库房管理" icon="goods" subtitle="对齐 Web 库房与资产模块，集中管理出入库与库存">
    <view class="kpi-board">
      <view class="kpi-item">
        <view class="kpi-label">仓库数量</view>
        <view class="kpi-value">{{kpis.warehouseCount}}</view>
      </view>
      <view class="kpi-item yellow">
        <view class="kpi-label traffic-yellow">待处理制单</view>
        <view class="kpi-value traffic-yellow">{{kpis.pendingOrderCount}}</view>
      </view>
      <view class="kpi-item red">
        <view class="kpi-label traffic-red">库存预警</view>
        <view class="kpi-value traffic-red">{{kpis.alertCount}}</view>
      </view>
      <view class="kpi-item green">
        <view class="kpi-label traffic-green">库存条目</view>
        <view class="kpi-value traffic-green">{{kpis.inventoryCount}}</view>
      </view>
    </view>

    <view class="entry-grid">
      <view class="entry-card" data-path="/pages/warehouse-stock-order/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">🧾 出入库制单</view></view>
        <view class="entry-desc">创建入库/出库/调拨单并提交审批</view>
      </view>
      <view class="entry-card" data-path="/pages/warehouse-dispatch/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">🚚 调度看板</view></view>
        <view class="entry-desc">查看待执行单据并快速执行</view>
      </view>
      <view class="entry-card" data-path="/pages/warehouse-inventory/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">📊 库存与预警</view></view>
        <view class="entry-desc">库存总览、预警与耗材消耗登记</view>
      </view>
      <view class="entry-card" data-path="/pages/asset/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">📦 资产设备查验</view></view>
        <view class="entry-desc">扫码查询设备状态并记录出入库事件</view>
      </view>
    </view>
  </hy-panel-card>

  <view class="fab-helper" bindtap="openGlobalHelper">🎤</view>
</view>
