<view class="page">
  <hy-panel-card title="📍 现场指挥中心" icon="location" subtitle="{{currentProject}}">
    <view class="kpi-item green">
      <view class="kpi-label traffic-green">🟢 项目总进度</view>
      <view class="kpi-value traffic-green">57%</view>
    </view>

    <view wx:for="{{sections}}" wx:key="name" class="section-card">
      <view class="section-title">🚧 {{item.name}}</view>
      <progress percent="{{item.percent}}" stroke-width="10" activeColor="#17803d" backgroundColor="#f0d8b0" />
      <view class="section-sub">{{item.done}}m / {{item.total}}m</view>
    </view>

    <view class="entry-grid">
      <view class="entry-card" data-path="/pages/log/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">📝 双轨日志</view></view>
        <view class="entry-desc">现场概况 + 顶进数据</view>
      </view>
      <view class="entry-card" data-path="/pages/operator-log/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">🚜 报顶进数据</view></view>
        <view class="entry-desc">语音提取关键数值</view>
      </view>
      <view class="entry-card" data-path="/pages/asset/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">📦 设备查验</view></view>
        <view class="entry-desc">红黄绿设备状态</view>
      </view>
      <view class="entry-card" data-path="/pages/survey/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">👷 安全勘查</view></view>
        <view class="entry-desc">拍照 + 经纬度 + AI标注</view>
      </view>
    </view>
  </hy-panel-card>

  <view class="fab-helper" bindtap="openGlobalHelper">🎤</view>
</view>
