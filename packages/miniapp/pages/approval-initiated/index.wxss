.bucket-row {
  display: flex;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.bucket-chip {
  flex: 1;
  border: 1rpx solid #d9e4f3;
  background: #f5f8fc;
  border-radius: 14rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.bucket-chip--active {
  border-color: #3f7af8;
  background: #ecf3ff;
}

.bucket-chip__title {
  color: #42526b;
  font-size: 22rpx;
}

.bucket-chip__count {
  margin-top: 4rpx;
  color: #1e2a3a;
  font-size: 30rpx;
  font-weight: 700;
}

.count-tip {
  margin-bottom: 12rpx;
  color: #5f6f86;
  font-size: 24rpx;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.filter-item {
  flex: 1;
}

.filter-label {
  font-size: 22rpx;
  color: #66778f;
  margin-bottom: 6rpx;
}

.filter-value {
  background: #f5f8fc;
  border: 1rpx solid #d9e4f3;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  font-size: 24rpx;
  color: #2f3f56;
}

.row {
  margin-top: 8rpx;
}

.biz-detail {
  margin-bottom: 8rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  background: #f6f9ff;
  color: #243246;
  font-size: 24rpx;
  line-height: 1.45;
}

.approval-card {
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  padding: 4rpx;
  box-sizing: border-box;
}

.card-payment {
  background: linear-gradient(180deg, #f5f9ff, #eef5ff);
}

.card-contract-out {
  background: linear-gradient(180deg, #f6fcf7, #eff8f1);
}

.card-contract-in {
  background: linear-gradient(180deg, #fff9f2, #fff4e8);
}

.card-reimburse {
  background: linear-gradient(180deg, #fff7fb, #fef0f8);
}

.card-default {
  background: linear-gradient(180deg, #f7f8fb, #f1f4f8);
}
