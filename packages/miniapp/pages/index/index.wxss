.btn {
  font-size: 28rpx;
}

.search-input {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #d9e1ec;
  border-radius: 12rpx;
  background: #fff;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
}

.project-card {
  margin-top: 16rpx;
  border: 1px solid #dbe8f7;
  border-radius: 16rpx;
  padding: 18rpx;
  background: #fff;
}

.project-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.project-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #18344f;
}

.project-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5c667a;
}

.empty-tip {
  margin-top: 12rpx;
  color: #8a94a7;
  font-size: 24rpx;
}

.entry-grid {
  margin-top: 14rpx;
}
