.greeting {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 4rpx 16rpx;
}

.greeting-text {
  min-width: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2329;
}

.greeting-date {
  flex: none;
  font-size: 24rpx;
  color: #5c667a;
}

/* 待办数字 */
.todos {
  display: flex;
  overflow: hidden;
  background: #fff;
  border-radius: 20rpx;
}

.todo {
  flex: 1;
  min-width: 0;
  padding: 22rpx 4rpx 20rpx;
  text-align: center;
}

.todo + .todo {
  border-left: 1rpx solid #edf1f6;
}

.todo-hover,
.entry-hover,
.approval-hover,
.section-head-hover {
  background: #f0f4fa;
}

.todo-count {
  font-size: 48rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
  color: #b4bccb;
}

.todo-count-alert {
  color: #d9480f;
}

.todo-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #1f2329;
}

.chevron {
  margin-left: 4rpx;
  color: #b4bccb;
}

.todo-hint {
  margin: 10rpx 4rpx 0;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a5300;
}

/* 分区 */
.section {
  margin-top: 16rpx;
  padding: 22rpx 20rpx 12rpx;
  background: #fff;
  border-radius: 20rpx;
}

.section-title {
  margin: 0 4rpx 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.section-title-inline {
  margin-bottom: 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 6rpx;
  padding: 2rpx 4rpx 8rpx 0;
  border-radius: 8rpx;
}

.section-more {
  font-size: 24rpx;
  color: #1677ff;
}

/* 入口：实色方块配白色线条图标，颜色表示类别 */
.grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 4rpx;
}

.entry {
  padding: 10rpx 0 14rpx;
  text-align: center;
  border-radius: 16rpx;
}

.entry-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto;
  border-radius: 24rpx;
}

.entry-icon {
  display: block;
  width: 50rpx;
  height: 50rpx;
}

.entry-tile-blue {
  background: #2f7bf6;
}

.entry-tile-green {
  background: #16a06f;
}

.entry-tile-orange {
  background: #e8750f;
}

.entry-tile-slate {
  background: #64748b;
}

.entry-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #1f2329;
}

/* 待审批预览 */
.approval {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 4rpx;
  border-top: 1rpx solid #edf1f6;
}

.approval-main {
  flex: 1;
  min-width: 0;
}

.approval-title {
  overflow: hidden;
  font-size: 27rpx;
  line-height: 1.5;
  color: #1f2329;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.approval-meta {
  overflow: hidden;
  margin-top: 2rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: #8a94a6;
  white-space: pre;
  text-overflow: ellipsis;
}

.approval-amount {
  flex: none;
  max-width: 260rpx;
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: #1f2329;
  word-break: break-all;
  text-align: right;
}
