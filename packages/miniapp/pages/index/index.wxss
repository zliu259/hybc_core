.btn {
  font-size: 28rpx;
}

.workbench-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #183f36 0%, #2f6c5f 100%);
  box-shadow: 0 16rpx 36rpx rgba(47, 108, 95, 0.22);
}

.workbench-hero.yellow {
  background: linear-gradient(135deg, #624412 0%, #c4872b 100%);
}

.workbench-hero.red {
  background: linear-gradient(135deg, #5d1c1c 0%, #bd3f3f 100%);
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 800;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.risk-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 23rpx;
}

.risk-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f0fff4;
  border: 1px solid #bde8c6;
}

.risk-card.yellow {
  background: #fff7ea;
  border-color: #ffd99a;
}

.risk-card.red {
  background: #fff1f1;
  border-color: #ffc7c7;
}

.risk-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
}

.risk-desc {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #5c667a;
}

.risk-count {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  color: #1f2329;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.action-card {
  min-height: 116rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #f8fbff;
  border: 1px solid #dbe8f7;
}

.action-card:active,
.manager-entry:active,
.entry-card:active {
  opacity: 0.82;
}

.action-card.blue {
  background: #eef6ff;
  border-color: #cfe3ff;
}

.action-card.green {
  background: #eefbf3;
  border-color: #c9edd5;
}

.action-card.orange {
  background: #fff7ea;
  border-color: #ffd99a;
}

.action-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #1f2329;
}

.action-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #5c667a;
}

.manager-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #183f36 0%, #2f6c5f 100%);
  color: #ffffff;
}

.review-entry {
  margin-top: 14rpx;
  background: linear-gradient(135deg, #65350f 0%, #c06a1c 100%);
}

.manager-copy {
  flex: 1;
  min-width: 0;
}

.manager-title {
  font-size: 34rpx;
  font-weight: 800;
}

.manager-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.82);
}

.manager-arrow {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
}

.review-badge {
  flex: 0 0 auto;
  min-width: 96rpx;
  padding: 12rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
  text-align: center;
}

.review-count {
  font-size: 36rpx;
  line-height: 1;
  font-weight: 800;
}

.review-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.entry-grid {
  margin-top: 14rpx;
}
