.page {
  min-height: 100vh;
  padding: 24rpx;
}

.card {
  background: #fffaf2;
  border: 1px solid #d9ceb9;
  border-radius: 20rpx;
  padding: 28rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2f6c5f;
}

.desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #6e6458;
}
