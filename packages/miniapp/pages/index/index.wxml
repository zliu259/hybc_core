<view class="page">
  <view class="greeting">
    <text class="greeting-text">{{greeting.text}}</text>
    <text class="greeting-date">{{greeting.dateText}}</text>
  </view>

  <!-- 待办：每个数字都能点，点了直接去处理 -->
  <view class="todos">
    <view
      wx:for="{{todos}}"
      wx:key="key"
      class="todo"
      hover-class="todo-hover"
      data-path="{{item.path}}"
      bindtap="openPath"
    >
      <view class="todo-count {{item.alert ? 'todo-count-alert' : ''}}">{{item.countText}}</view>
      <view class="todo-label">{{item.label}}<text class="chevron">›</text></view>
    </view>
  </view>
  <view wx:if="{{someCountsFailed}}" class="todo-hint">有些数字没有取到，下拉刷新重试</view>

  <view class="section">
    <view class="section-title">常用</view>
    <view class="grid">
      <view
        wx:for="{{common}}"
        wx:key="key"
        class="entry"
        hover-class="entry-hover"
        data-key="{{item.key}}"
        data-path="{{item.path}}"
        bindtap="openEntry"
      >
        <view class="entry-tile entry-tile-{{item.tone}}">
          <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="entry-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{pendingPreview.length > 0}}" class="section">
    <view class="section-head" hover-class="section-head-hover" bindtap="openAllApprovals">
      <text class="section-title section-title-inline">待我审批</text>
      <text class="section-more">全部 {{pendingTotal}} 条<text class="chevron">›</text></text>
    </view>
    <view
      wx:for="{{pendingPreview}}"
      wx:key="id"
      class="approval"
      hover-class="approval-hover"
      data-id="{{item.id}}"
      bindtap="openApproval"
    >
      <view class="approval-main">
        <view class="approval-title">{{item.title}}</view>
        <view class="approval-meta">{{item.metaText}}</view>
      </view>
      <view wx:if="{{item.amountText}}" class="approval-amount">{{item.amountText}}</view>
    </view>
  </view>

  <view wx:if="{{more.length > 0}}" class="section">
    <view class="section-title">全部功能</view>
    <view class="grid">
      <view
        wx:for="{{more}}"
        wx:key="key"
        class="entry"
        hover-class="entry-hover"
        data-key="{{item.key}}"
        data-path="{{item.path}}"
        bindtap="openEntry"
      >
        <view class="entry-tile entry-tile-{{item.tone}}">
          <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="entry-label">{{item.label}}</view>
      </view>
    </view>
  </view>
</view>
