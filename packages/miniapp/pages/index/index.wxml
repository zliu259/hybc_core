<view class="page">
  <hy-panel-card title="{{title}}" icon="dashboard" subtitle="项目列表与项目详情入口">
    <view class="stats-row">
      <view class="stat-card">
        <view class="stat-value">{{pendingCount}}</view>
        <view class="stat-label">待审批</view>
      </view>
      <view class="stat-card">
        <view class="stat-value">{{noticeCount}}</view>
        <view class="stat-label">消息通知</view>
      </view>
    </view>
    <view class="row mt-2">
      <input class="search-input" placeholder="按项目编号或名称筛选" value="{{keyword}}" bindinput="onKeywordInput" />
      <t-button class="btn btn-primary mt-2" theme="primary" block bindtap="searchProjects" loading="{{loading}}" disabled="{{loading}}">查询项目</t-button>
    </view>
    <view wx:if="{{projects.length === 0}}" class="empty-tip">暂无项目数据</view>
    <view wx:for="{{projects}}" wx:key="id" class="project-card" data-id="{{item.id}}" data-participant="{{item.participant}}" bindtap="openProjectDetail">
      <view class="project-title-row">
        <view class="project-title">{{item.project_name}}</view>
        <hy-status-chip text="{{item.participant ? '参与者' : '只读'}}" type="{{item.participant ? 'success' : 'warning'}}" />
      </view>
      <view class="project-sub">{{item.project_code}} · {{item.status}}</view>
      <view class="project-sub">项目经理：{{item.manager_userid}}</view>
    </view>
  </hy-panel-card>
</view>
