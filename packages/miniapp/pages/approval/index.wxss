.tab-row {
  display: flex;
  gap: 8rpx;
  margin: 4rpx 0 12rpx;
}

.tab-pill {
  flex: 1;
  border-radius: 999rpx;
  padding: 14rpx 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #55657b;
  background: #eef4fb;
}

.tab-pill.active {
  color: #fff;
  background: #1677ff;
}

.approval-card {
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  padding: 4rpx;
  box-sizing: border-box;
}

.card-payment {
  background: linear-gradient(180deg, #f5f9ff, #eef5ff);
}

.card-contract-out {
  background: linear-gradient(180deg, #f6fcf7, #eff8f1);
}

.card-contract-in {
  background: linear-gradient(180deg, #fff9f2, #fff4e8);
}

.card-reimburse {
  background: linear-gradient(180deg, #fff7fb, #fef0f8);
}

.card-default {
  background: linear-gradient(180deg, #f7f8fb, #f1f4f8);
}
