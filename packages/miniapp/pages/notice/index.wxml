<view class="page">
  <view class="card">
    <view class="title">通知消息列表</view>
    <button class="btn" bindtap="loadNotices" loading="{{loading}}" disabled="{{loading}}">刷新</button>
  </view>
  <view class="empty-state" wx:if="{{!loading && notices.length === 0}}">暂无通知消息</view>
  <block wx:for="{{notices}}" wx:key="id">
    <view class="card">
      <view>{{item.title}}</view>
      <view class="sub">{{item.content}}</view>
    </view>
  </block>
</view>
