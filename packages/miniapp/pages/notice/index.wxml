<view class="page">
  <hy-panel-card title="通知消息列表">
    <view class="row">
      <t-button class="btn btn-primary" theme="primary" block bindtap="loadNotices" loading="{{loading}}" disabled="{{loading}}">刷新</t-button>
    </view>
  </hy-panel-card>

  <t-empty wx:if="{{!loading && notices.length === 0}}" description="暂无通知消息" />

  <block wx:for="{{notices}}" wx:key="id">
    <hy-panel-card title="{{item.title}}">
      <view class="sub">{{item.content}}</view>
    </hy-panel-card>
  </block>
</view>
