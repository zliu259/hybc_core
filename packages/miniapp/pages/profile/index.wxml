<view class="page">
  <view class="card">
    <view class="title">个人中心</view>
    <view class="sub">用户ID: {{profile.id || profile.username || '-'}}</view>
    <view class="sub">昵称: {{profile.nickname || '-'}}</view>
    <view class="sub">角色: {{profile.roles ? profile.roles.join(',') : '-'}}</view>
    <view class="row">
      <button class="btn" bindtap="reloadProfile">刷新资料</button>
      <button class="btn" type="warn" bindtap="logout">退出登录</button>
    </view>
  </view>
</view>
