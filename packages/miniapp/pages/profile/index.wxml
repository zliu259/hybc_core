<view class="page">
  <hy-panel-card title="👤 我的中心" icon="user-circle" subtitle="个人申请追踪、报销与证书预警">
    <view class="section-title">📌 我的申请时间线</view>
    <view wx:if="{{!timeline.length}}" class="sub">暂无申请动态</view>
    <view wx:for="{{timeline}}" wx:key="text" class="timeline-item">
      <view class="timeline-left">{{item.icon}}</view>
      <view class="timeline-main">
        <view class="timeline-text">{{item.text}}</view>
        <view class="timeline-status">{{item.status}}</view>
      </view>
    </view>

    <view class="row">
      <t-button class="btn" variant="outline" bindtap="urgeApprovalFlow" loading="{{busy}}" disabled="{{busy}}">🔔 一键催办</t-button>
      <t-button class="btn btn-primary" theme="primary" data-path="/pages/reimbursement-list/index" bindtap="goToReimbursement">🧾 我的报销提交</t-button>
    </view>

    <view class="section-title">📚 我的证书</view>
    <view wx:if="{{!certificates.length}}" class="sub">暂无证书数据</view>
    <view class="cert-grid">
      <view wx:for="{{certificates}}" wx:key="id" class="cert-card {{item.level}}">
        <view class="cert-name">{{item.level === 'warn' ? '⚠️' : '✅'}} {{item.name}}</view>
        <view class="cert-meta">状态：{{item.statusText}}</view>
        <view class="cert-meta">附件：{{item.fileName || '未上传附件'}}</view>
        <view class="row cert-actions">
          <t-button
            class="btn"
            variant="outline"
            data-url="{{item.fileUrl}}"
            bindtap="openCertFile"
          >查看</t-button>
          <t-button
            class="btn btn-primary"
            theme="primary"
            data-url="{{item.fileUrl}}"
            data-name="{{item.fileName || item.name}}"
            bindtap="downloadCertFile"
          >下载</t-button>
        </view>
      </view>
    </view>

    <view class="profile-item"><view class="profile-icon">👤</view><view class="sub">用户ID：{{profile.id || profile.username || '-'}}</view></view>
    <view class="profile-item"><view class="profile-icon">🪪</view><view class="sub">昵称：{{profile.nickname || '-'}}</view></view>
    <view class="profile-item"><view class="profile-icon">🛡️</view><view class="sub">角色：{{profileRoleText}}</view></view>
    <view class="profile-item"><view class="profile-icon">✅</view><view class="sub">认证方式：{{profileAuthMethodText}}</view></view>
    <view class="profile-item"><view class="profile-icon">🕒</view><view class="sub">企微验证：{{profile.wecom_verified_at || '-'}}</view></view>
    <view class="row">
      <t-button class="btn btn-primary" theme="primary" bindtap="reloadProfile" loading="{{busy}}" disabled="{{busy}}">刷新资料</t-button>
      <t-button class="btn btn-warn" theme="danger" bindtap="logout">退出登录</t-button>
    </view>
  </hy-panel-card>

  <view class="fab-helper" bindtap="openGlobalHelper">🎤</view>
</view>
