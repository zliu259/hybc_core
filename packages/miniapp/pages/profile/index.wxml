<view class="page">
  <view class="profile-hero">
    <view class="avatar">{{avatarText}}</view>
    <view class="hero-main">
      <view class="hero-name">{{profile.nickname || profile.username || '我的中心'}}</view>
      <view class="hero-role">{{profileRoleText}}</view>
    </view>
    <view class="settings-pill" bindtap="openSettings">账号与配置</view>
  </view>

  <view class="summary-grid">
    <view class="summary-card">
      <view class="summary-value">{{timeline.length}}</view>
      <view class="summary-label">申请动态</view>
    </view>
    <view class="summary-card {{certificateWarnCount > 0 ? 'warn' : ''}}">
      <view class="summary-value">{{certificateWarnCount}}</view>
      <view class="summary-label">证书预警</view>
    </view>
    <view class="summary-card">
      <view class="summary-value">{{certificates.length}}</view>
      <view class="summary-label">证书总数</view>
    </view>
  </view>

  <hy-panel-card title="常用动作" icon="⚡" subtitle="个人高频事项放在最前面">
    <view class="action-grid">
      <view class="action-card green" bindtap="goToReimbursement">
        <view class="action-title">🧾 我的报销提交</view>
        <view class="action-desc">发起报销并跟踪状态</view>
      </view>
      <view class="action-card blue" bindtap="goToPaymentApply">
        <view class="action-title">💸 智能发单台</view>
        <view class="action-desc">发起对外付款申请</view>
      </view>
      <view class="action-card orange" bindtap="goToFuelApply">
        <view class="action-title">⛽ 油卡额度申请</view>
        <view class="action-desc">提交额度并查看记录</view>
      </view>
      <view class="action-card red" bindtap="urgeApprovalFlow">
        <view class="action-title">🔔 一键催办</view>
        <view class="action-desc">提醒待处理审批人</view>
      </view>
    </view>
  </hy-panel-card>

  <hy-panel-card title="我的申请时间线" icon="📌" subtitle="聚合最近个人业务动态">
    <t-empty wx:if="{{!timeline.length}}" description="暂无申请动态" />
    <view wx:for="{{timeline}}" wx:key="text" class="timeline-item">
      <view class="timeline-left">{{item.icon}}</view>
      <view class="timeline-main">
        <view class="timeline-text">{{item.text}}</view>
        <view class="timeline-status">{{item.status}}</view>
      </view>
    </view>
  </hy-panel-card>

  <hy-panel-card title="我的证书" icon="📚" subtitle="查看证书状态和附件">
    <t-empty wx:if="{{!certificates.length}}" description="暂无证书数据" />
    <view class="cert-grid">
      <view wx:for="{{certificates}}" wx:key="id" class="cert-card {{item.level}}">
        <view class="cert-name">{{item.level === 'warn' ? '⚠️' : '✅'}} {{item.name}}</view>
        <view class="cert-meta">状态：{{item.statusText}}</view>
        <view class="cert-meta">附件：{{item.fileName || '未上传附件'}}</view>
        <view class="row cert-actions">
          <t-button
            class="btn"
            variant="outline"
            data-url="{{item.fileUrl}}"
            bindtap="openCertFile"
          >查看</t-button>
          <t-button
            class="btn btn-primary"
            theme="primary"
            data-url="{{item.fileUrl}}"
            data-name="{{item.fileName || item.name}}"
            bindtap="downloadCertFile"
          >下载</t-button>
        </view>
      </view>
    </view>
  </hy-panel-card>
</view>
