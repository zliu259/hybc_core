<view class="page">
  <view class="card">
    <view class="title">个人中心</view>
    <view class="label required">API地址（企微开发者工具）</view>
    <input class="input" value="{{baseUrl}}" bindinput="onBaseUrlInput" />
    <button class="btn" bindtap="saveBaseUrl">保存地址</button>
    <view class="sub">用户ID: {{profile.id || profile.username || '-'}}</view>
    <view class="sub">昵称: {{profile.nickname || '-'}}</view>
    <view class="sub">角色: {{profile.roles ? profile.roles.join(',') : '-'}}</view>
    <view class="row">
      <button class="btn" bindtap="reloadProfile" loading="{{busy}}" disabled="{{busy}}">刷新资料</button>
      <button class="btn" type="warn" bindtap="logout">退出登录</button>
    </view>
  </view>
</view>
