.sub {
  margin-top: 8rpx;
}

.profile-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.profile-icon {
  width: 30rpx;
  text-align: center;
  font-size: 24rpx;
}

.timeline-item {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  background: #f6f9fd;
}

.timeline-left {
  font-size: 30rpx;
}

.timeline-main {
  flex: 1;
}

.timeline-text {
  font-size: 26rpx;
  color: #20324a;
}

.timeline-status {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #5d6a7f;
}

.cert-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
  margin-top: 8rpx;
}

.cert-card {
  border-radius: 14rpx;
  padding: 14rpx;
  font-size: 24rpx;
}

.cert-name {
  font-size: 26rpx;
  color: #20324a;
}

.cert-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5d6a7f;
}

.cert-actions {
  margin-top: 10rpx;
}

.cert-card.warn {
  background: #fff3e6;
  border: 1px solid #ffd39a;
}

.cert-card.ok {
  background: #effcf0;
  border: 1px solid #b7e7c3;
}
