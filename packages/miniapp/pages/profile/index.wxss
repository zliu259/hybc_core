.profile-hero {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #183f36 0%, #2f6c5f 100%);
  box-shadow: 0 16rpx 36rpx rgba(47, 108, 95, 0.22);
}

.avatar {
  flex: 0 0 auto;
  width: 86rpx;
  height: 86rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.18);
  font-size: 38rpx;
  font-weight: 800;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-size: 38rpx;
  font-weight: 800;
}

.hero-role {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.settings-pill {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
}

.settings-pill:active,
.action-card:active {
  opacity: 0.82;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
  margin: 18rpx 0 20rpx;
}

.summary-card {
  min-height: 128rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1px solid #dbe8f7;
  box-sizing: border-box;
}

.summary-card.warn {
  background: #fff7ea;
  border-color: #ffd99a;
}

.summary-value {
  font-size: 40rpx;
  line-height: 1.1;
  font-weight: 800;
  color: #1f2329;
}

.summary-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #5c667a;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.action-card {
  min-height: 148rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  box-sizing: border-box;
  background: #f8fbff;
  border: 1px solid #dbe8f7;
}

.action-card.blue {
  background: #eef6ff;
  border-color: #cfe3ff;
}

.action-card.green {
  background: #eefbf3;
  border-color: #c9edd5;
}

.action-card.orange {
  background: #fff7ea;
  border-color: #ffd99a;
}

.action-card.red {
  background: #fff1f1;
  border-color: #ffc7c7;
}

.action-title {
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #1f2329;
}

.action-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #5c667a;
}

.sub {
  margin-top: 8rpx;
}

.profile-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.profile-icon {
  width: 30rpx;
  text-align: center;
  font-size: 24rpx;
}

.timeline-item {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  background: #f6f9fd;
}

.timeline-left {
  font-size: 30rpx;
}

.timeline-main {
  flex: 1;
}

.timeline-text {
  font-size: 26rpx;
  color: #20324a;
}

.timeline-status {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #5d6a7f;
}

.cert-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
  margin-top: 8rpx;
}

.cert-card {
  border-radius: 14rpx;
  padding: 14rpx;
  font-size: 24rpx;
}

.cert-name {
  font-size: 26rpx;
  color: #20324a;
}

.cert-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #5d6a7f;
}

.cert-actions {
  margin-top: 10rpx;
}

.cert-card.warn {
  background: #fff3e6;
  border: 1px solid #ffd39a;
}

.cert-card.ok {
  background: #effcf0;
  border: 1px solid #b7e7c3;
}
