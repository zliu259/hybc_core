.segment-wrap {
  display: flex;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1px solid #d9e5f5;
  margin-bottom: 14rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 10rpx;
  background: #f5f8fc;
  font-size: 26rpx;
  color: #55657b;
}

.segment-item.active {
  background: #1677ff;
  color: #fff;
  font-weight: 600;
}

.pending-tip {
  padding: 24rpx 12rpx;
  text-align: center;
  color: #6b7a90;
  font-size: 24rpx;
}

.pending-entry .entry-desc {
  margin-top: 6rpx;
}

.entry-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7a90;
}
