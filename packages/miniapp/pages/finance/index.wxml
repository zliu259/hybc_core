<view class="page">
  <hy-panel-card title="✅ 审批与申请" icon="task-checked" subtitle="红黄绿摘要 + 滑动式决策">
    <view class="segment-wrap">
      <view class="segment-item {{segment === 'pending' ? 'active' : ''}}" data-value="pending" bindtap="onSegmentChange">
        待我审批（{{pendingCount}}）
      </view>
      <view class="segment-item {{segment === 'apply' ? 'active' : ''}}" data-value="apply" bindtap="onSegmentChange">
        发起申请
      </view>
    </view>

    <view wx:if="{{segment === 'pending'}}" class="entry-grid">
      <view class="entry-card" data-path="/pages/approval/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">🔴 统一审批列表</view></view>
        <view class="entry-desc">右滑快批，减少点选层级</view>
      </view>
      <view class="entry-card" data-path="/pages/approval/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">🟢 AI 摘要卡片</view></view>
        <view class="entry-desc">红灯拦截/黄灯提醒/绿灯放行</view>
      </view>
    </view>

    <view wx:if="{{segment === 'apply'}}" class="entry-grid">
      <view wx:if="{{canPaymentApply}}" class="entry-card" data-path="/pages/payment-apply/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">💸 发起对外付款</view></view>
        <view class="entry-desc">金额阈值校验 + 合同联动</view>
      </view>
      <view wx:else class="entry-card">
        <view class="entry-top"><view class="entry-title">💸 发起对外付款</view></view>
        <view class="entry-desc">当前角色无权限</view>
      </view>
      <view class="entry-card" data-path="/pages/reimbursement-list/index" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">🧾 我的报销提交</view></view>
        <view class="entry-desc">发起报销、上传票据、跟踪状态</view>
      </view>
    </view>
  </hy-panel-card>

  <view class="fab-helper" bindtap="openGlobalHelper">🎤</view>
</view>
