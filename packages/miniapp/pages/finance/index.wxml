<view class="page">
  <hy-panel-card title="财务工作台" icon="money-circle" subtitle="最少操作完成报销与审批流程">
    <view class="entry-grid">
      <view class="entry-card" data-path="/pages/reimbursement/index" bindtap="goTo">
        <view class="entry-top"><t-icon name="scan" size="32rpx" color="#1677ff" /><view class="entry-title">报销扫码</view></view>
        <view class="entry-desc">纸质与电子发票双通道</view>
      </view>
      <view class="entry-card" data-path="/pages/approval/index" bindtap="goTo">
        <view class="entry-top"><t-icon name="task-checked" size="32rpx" color="#1677ff" /><view class="entry-title">审批待办</view></view>
        <view class="entry-desc">移动端快速审批</view>
      </view>
      <view class="entry-card" data-path="/pages/notice/index" bindtap="goTo">
        <view class="entry-top"><t-icon name="notification" size="32rpx" color="#1677ff" /><view class="entry-title">通知消息</view></view>
        <view class="entry-desc">财务提醒统一收口</view>
      </view>
      <view class="entry-card" data-path="/pages/progress/index" bindtap="goTo">
        <view class="entry-top"><t-icon name="chart" size="32rpx" color="#1677ff" /><view class="entry-title">财务进度</view></view>
        <view class="entry-desc">状态查询与异常提示</view>
      </view>
    </view>
  </hy-panel-card>
</view>
