<view class="page">
  <hy-panel-card title="🔎 查询" subtitle="高权限查询入口：合同 / 付款 / 收款">
    <view class="entry-grid">
      <view wx:for="{{entries}}" wx:key="title" class="entry-card" data-path="{{item.path}}" bindtap="goTo">
        <view class="entry-top"><view class="entry-title">{{item.title}}</view></view>
        <view class="entry-desc">{{item.desc}}</view>
      </view>
    </view>
  </hy-panel-card>
</view>
