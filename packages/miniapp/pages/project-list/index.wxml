<view class="page">
  <hy-panel-card title="项目列表" icon="list" subtitle="专门项目页，避免工作台列表过长">
    <view class="search-row">
      <input class="search-input" placeholder="按项目编号或名称筛选" value="{{keyword}}" bindinput="onKeywordInput" />
      <t-button class="search-btn" theme="primary" bindtap="searchProjects" loading="{{loading}}" disabled="{{loading}}">查询</t-button>
    </view>

    <view class="filter-row">
      <picker class="filter-cell" mode="selector" range="{{statusNames}}" value="{{statusIndex}}" bindchange="onStatusChange" disabled="{{loading}}">
        <view class="filter-input">{{statusNames[statusIndex]}}</view>
      </picker>
      <picker class="filter-cell" mode="selector" range="{{scopeNames}}" value="{{scopeIndex}}" bindchange="onScopeChange" disabled="{{loading}}">
        <view class="filter-input">{{scopeNames[scopeIndex]}}</view>
      </picker>
      <t-button class="reset-btn" variant="outline" bindtap="resetFilters" disabled="{{loading}}">重置</t-button>
    </view>

    <view wx:if="{{projects.length === 0}}" class="empty-tip">暂无项目数据</view>
    <view wx:for="{{projects}}" wx:key="id" class="project-card" data-id="{{item.id}}" data-participant="{{item.participant}}" bindtap="openProjectDetail">
      <view class="project-title-row">
        <view class="project-title">{{item.project_name}}</view>
        <hy-status-chip text="{{item.participant ? '参与者' : '只读'}}" type="{{item.participant ? 'success' : 'warning'}}" />
      </view>
      <view class="project-sub">{{item.project_code}} · {{item.statusText}}</view>
      <view class="project-sub">项目经理：{{item.manager_userid}}</view>
    </view>
  </hy-panel-card>
</view>
