<view class="page">
  <view class="search">
    <input
      class="search-input"
      placeholder="搜项目名称或编号"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onKeywordConfirm"
    />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword">清除</text>
  </view>

  <scroll-view class="chips" scroll-x enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{statusChips}}"
      wx:key="value"
      class="chip {{status === item.value ? 'chip-active' : ''}}"
      data-value="{{item.value}}"
      bindtap="selectStatus"
    >{{item.label}}</view>
  </scroll-view>

  <view class="summary">
    <text class="summary-count" wx:if="{{!loading && !loadError}}">共 {{total}} 个项目</text>
    <text class="summary-count" wx:if="{{loading}}">正在加载</text>
    <text class="mine {{mineOnly ? 'mine-active' : ''}}" bindtap="toggleMine">{{mineOnly ? '✓ ' : ''}}只看我负责的</text>
  </view>

  <view wx:if="{{loadError}}" class="state">
    <view class="state-text">{{loadError}}</view>
    <t-button size="small" variant="outline" bindtap="loadFirstPage">重试</t-button>
  </view>

  <view wx:elif="{{!loading && projects.length === 0}}" class="state">
    <view class="state-text">没有符合条件的项目</view>
    <t-button size="small" variant="outline" bindtap="clearFilters">清除筛选</t-button>
  </view>

  <view
    wx:for="{{projects}}"
    wx:key="id"
    class="project-card {{item.archived ? 'project-card-archived' : ''}}"
    data-id="{{item.id}}"
    data-readonly="{{item.readonly}}"
    bindtap="openProjectDetail"
  >
    <view class="project-head">
      <view class="project-name">{{item.name}}</view>
      <t-tag class="project-tag" theme="{{item.statusTheme}}" variant="light" size="small">{{item.statusText}}</t-tag>
    </view>
    <view class="project-meta">
      <text>负责人 {{item.managerName}}</text>
      <text wx:if="{{item.startDate}}">开工 {{item.startDate}}</text>
    </view>
    <view wx:if="{{item.location}}" class="project-location">{{item.location}}</view>
  </view>

  <view wx:if="{{projects.length > 0}}" class="list-foot">
    {{loadingMore ? '正在加载' : (hasMore ? '上拉加载更多' : '没有更多了')}}
  </view>
</view>
