.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
}

.search-clear {
  flex: none;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #1677ff;
}

/* 横向滚动用 inline-block，不用 enable-flex：flex 模式下标签会被拉满整屏高度 */
.chips {
  width: 100%;
  height: 60rpx;
  margin-top: 20rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #5c667a;
  background: #fff;
  border-radius: 999rpx;
}

.chip-active {
  font-weight: 600;
  color: #fff;
  background: #1677ff;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 56rpx;
  margin: 18rpx 4rpx 10rpx;
  font-size: 24rpx;
  color: #5c667a;
}

.mine {
  padding: 8rpx 0 8rpx 16rpx;
  color: #5c667a;
}

.mine-active {
  font-weight: 600;
  color: #1677ff;
}

.state {
  padding: 72rpx 24rpx;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
}

.state-text {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #5c667a;
}

.project-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
}

.project-card:active {
  background: #f5f8fc;
}

.project-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.project-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #1f2329;
  word-break: break-word;
}

.project-card-archived .project-name {
  font-weight: 500;
  color: #5c667a;
}

.project-tag {
  flex: none;
}

.project-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 28rpx;
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #5c667a;
}

.project-location {
  margin-top: 4rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #8a94a6;
  word-break: break-word;
}

.list-foot {
  padding: 16rpx 0 8rpx;
  font-size: 24rpx;
  text-align: center;
  color: #8a94a6;
}
