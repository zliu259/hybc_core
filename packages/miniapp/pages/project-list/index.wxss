.btn {
  font-size: 28rpx;
}

.search-row {
  margin-top: 12rpx;
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  box-sizing: border-box;
  border: 1px solid #d9e1ec;
  border-radius: 12rpx;
  background: #fff;
  min-height: 88rpx;
  padding: 0 20rpx;
  line-height: 88rpx;
  font-size: 26rpx;
}

.search-btn {
  width: 160rpx;
  min-height: 88rpx;
  --td-button-medium-height: 88rpx;
}

.filter-row {
  margin-top: 12rpx;
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.filter-cell {
  flex: 1;
}

.filter-input {
  box-sizing: border-box;
  border: 1px solid #d9e1ec;
  border-radius: 12rpx;
  background: #fff;
  min-height: 88rpx;
  padding: 0 20rpx;
  line-height: 88rpx;
  font-size: 24rpx;
  color: #1f2329;
}

.reset-btn {
  width: 120rpx;
  min-height: 88rpx;
  --td-button-medium-height: 88rpx;
}

.project-card {
  margin-top: 16rpx;
  border: 1px solid #dbe8f7;
  border-radius: 16rpx;
  padding: 18rpx;
  background: #fff;
}

.project-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.project-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #18344f;
}

.project-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5c667a;
}

.empty-tip {
  margin-top: 12rpx;
  color: #8a94a7;
  font-size: 24rpx;
}
