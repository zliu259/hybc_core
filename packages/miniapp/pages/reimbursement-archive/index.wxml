<view class="page">
  <hy-panel-card title="📂 信封扫码核查" subtitle="办公室扫码信封UUID，快速打开对应报销电子档案">
    <view class="toolbar">
      <t-button class="btn btn-primary" theme="primary" loading="{{loading}}" bindtap="onScanUuid"
        >扫码打开档案</t-button
      >
    </view>

    <view class="toolbar">
      <input
        class="input"
        value="{{envelopeUuidInput}}"
        bindinput="onUuidInput"
        placeholder="粘贴或输入信封UUID / 扫码链接"
      />
    </view>
    <view class="toolbar">
      <t-button class="btn" variant="outline" loading="{{loading}}" bindtap="onManualResolve"
        >手动定位并打开</t-button
      >
    </view>

    <view wx:if="{{latestResolved}}" class="latest-card">
      <view class="row-title">最近一次定位</view>
      <view class="row">编号：{{latestResolved.envelope_no}}</view>
      <view class="row">UUID：{{latestResolved.envelope_uuid}}</view>
      <view class="row">申请人：{{latestResolved.applicant_userid}}</view>
      <view class="row">金额：¥{{latestResolved.amount}}</view>
      <view class="row">状态：{{latestResolved.statusText}}</view>
      <view class="row">时间：{{latestResolved.opened_at}}</view>
    </view>

    <view class="history-head">
      <view class="head-title">最近核查记录</view>
    </view>
    <view wx:if="{{!history.length}}" class="empty">暂无核查记录</view>
    <view wx:for="{{history}}" wx:key="envelope_uuid" class="item-card">
      <view class="item-top">
        <view class="item-no">{{item.envelope_no}}</view>
        <hy-status-chip text="{{item.statusText}}" theme="warning" variant="light" />
      </view>
      <view class="item-sub">UUID：{{item.envelope_uuid}}</view>
      <view class="item-sub">申请人：{{item.applicant_userid}} · 金额：¥{{item.amount}}</view>
      <view class="item-sub">最近打开：{{item.opened_at}}</view>
      <view class="actions">
        <t-button class="btn" size="small" variant="outline" data-uuid="{{item.envelope_uuid}}" bindtap="onOpenFromHistory"
          >再次打开</t-button
        >
      </view>
    </view>
  </hy-panel-card>
</view>
