.amount-wrap {
  background: #f8fbff;
  border: 1rpx solid #dce8f8;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 18rpx;
}

.amount-input {
  margin-top: 10rpx;
}

.amount-display {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #49586a;
  font-weight: 600;
}

.threshold-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.threshold-hint.ok {
  color: #117a3f;
}

.threshold-hint.warn {
  color: #b26a00;
}

.section-block {
  margin-top: 18rpx;
  border: 1rpx solid #e4ebf4;
  border-radius: 14rpx;
  padding: 16rpx;
  background: #fff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2d3d;
  margin-bottom: 8rpx;
}

.picker-value {
  border: 1rpx solid #d8dce5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
  background: #fff;
  font-size: 28rpx;
  color: #1f2329;
}

.textarea {
  min-height: 128rpx;
  border: 1rpx solid #d8dce5;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 12rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.attachment-empty {
  margin-top: 12rpx;
  color: #7b8494;
  font-size: 24rpx;
}

.attachment-item {
  margin-top: 10rpx;
  border: 1rpx solid #e3e8ef;
  border-radius: 12rpx;
  background: #fdfefe;
  padding: 12rpx;
}

.attachment-name {
  font-size: 26rpx;
  color: #1f2937;
  word-break: break-all;
}

.attachment-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #697789;
}

.mini-btn {
  margin-top: 8rpx;
}

.switch-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #334155;
}

.first-payment-box {
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid #dbe8f8;
  background: #f7fbff;
}

.quick-payee-row {
  margin-top: 10rpx;
}

.quick-payee-box {
  border-style: dashed;
  border-color: #cddff5;
  background: #f8fbff;
}
