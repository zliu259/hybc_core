.settings-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1f3555 0%, #2d5f9a 100%);
  box-shadow: 0 16rpx 36rpx rgba(45, 95, 154, 0.22);
}

.hero-kicker {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-title {
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.82);
}

.hero-mark {
  flex: 0 0 auto;
  width: 86rpx;
  height: 86rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
  font-size: 38rpx;
  font-weight: 800;
}

.info-list {
  margin-top: 10rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1px solid #edf1f6;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex: 0 0 auto;
  font-size: 25rpx;
  color: #5c667a;
}

.info-value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 25rpx;
  line-height: 1.45;
  color: #1f2329;
  word-break: break-all;
}

.config-hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #5c667a;
}
