<view class="page">
  <hy-panel-card title="管理员日志" subtitle="支持拍照上传与结构化提交流程">
    <hy-project-picker value="{{projectId}}" label="所属项目" bind:change="onProjectChange" />
    <view class="label required">日期</view>
    <picker mode="date" value="{{form.log_date}}" bindchange="onDateChange" disabled="{{busy}}">
      <view class="input">{{form.log_date}}</view>
    </picker>
    <view class="label">标题</view>
    <input class="input" value="{{form.title}}" data-key="title" bindinput="onInput" disabled="{{busy}}" />
    <view class="label">日志内容</view>
    <textarea class="input" value="{{form.detail_html}}" data-key="detail_html" bindinput="onInput" disabled="{{busy}}" />
    <view class="row">
      <hy-status-chip text="已上传图片 {{form.photos.length}} 张" theme="primary" variant="light" />
    </view>
    <view class="row">
      <t-button class="btn" variant="outline" bindtap="pickPhoto" loading="{{busy}}" disabled="{{busy}}">拍照/选图</t-button>
      <t-button class="btn btn-primary" theme="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交日志</t-button>
    </view>
  </hy-panel-card>
</view>
