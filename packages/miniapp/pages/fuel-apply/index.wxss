.picker-value {
  width: 100%;
  background: #fff;
  border: 1rpx solid #d7dbe3;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #1f2937;
}

.empty-tip {
  margin-top: 12rpx;
  color: #7b8494;
  font-size: 24rpx;
}

.photo-item,
.record-item {
  margin-top: 12rpx;
  padding: 14rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fff;
}

.photo-name,
.record-title {
  color: #111827;
  font-size: 26rpx;
  word-break: break-all;
}

.photo-size,
.record-line {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.mini-btn {
  margin-top: 8rpx;
}
