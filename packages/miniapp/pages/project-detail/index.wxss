.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

.card-empty {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #8a94a6;
}

.state {
  padding: 72rpx 24rpx;
  text-align: center;
}

.state-text {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #5c667a;
}

/* 头部 */
.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-code {
  min-width: 0;
  font-size: 24rpx;
  color: #8a94a6;
  word-break: break-all;
}

.hero-name {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #1f2329;
  word-break: break-word;
}

/* 五段阶段条：颜色跟状态标签走，走过的浅、当前的深 */
.stages {
  display: flex;
  gap: 6rpx;
  margin: 24rpx 0 18rpx;
  --stage-color: #1677ff;
  --stage-past: #b5d3fb;
}

.stages-active {
  --stage-color: #2ba471;
  --stage-past: #b4e0cb;
}

.stages-preparing {
  --stage-color: #e37318;
  --stage-past: #f7cfa8;
}

.stages-archived {
  --stage-color: #8a94a6;
  --stage-past: #d5dae3;
}

.stage {
  flex: 1;
  min-width: 0;
  text-align: center;
}

.stage-bar {
  height: 12rpx;
  background: #e8edf4;
  border-radius: 4rpx;
}

.stage-past .stage-bar {
  background: var(--stage-past);
}

.stage-current .stage-bar {
  background: var(--stage-color);
}

.stage-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a94a6;
}

.stage-current .stage-label {
  font-weight: 600;
  color: var(--stage-color);
}

.kv {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 10rpx;
}

.k {
  flex: none;
  width: 150rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #5c667a;
}

.v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.55;
  color: #1f2329;
  word-break: break-word;
}

.readonly-note {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #5c667a;
  background: #eef1f5;
  border-radius: 12rpx;
}

.hero-action {
  margin-top: 22rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 84rpx;
  text-align: center;
  color: #fff;
  background: #1677ff;
  border-radius: 12rpx;
}

.hero-action-hover {
  background: #0f5fd1;
}

/* 项目交底 */
.briefing-rows {
  margin-top: 6rpx;
}

.briefing-plain,
.briefing-text {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #1f2329;
  white-space: pre-wrap;
  word-break: break-word;
}

/* 外部日志复核入口 */
.link-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.link-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.link-value {
  font-size: 26rpx;
  color: #8a94a6;
}

.link-value-alert {
  font-weight: 600;
  color: #e37318;
}

.chevron {
  margin-left: 10rpx;
  font-size: 30rpx;
  color: #b4bccb;
}

/* 标段 */
.section {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf1f6;
}

.section:active {
  background: #f5f8fc;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  color: #1f2329;
  word-break: break-word;
}

.section-status {
  flex: none;
  font-size: 24rpx;
  line-height: 42rpx;
  color: #5c667a;
}

.section-progress {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
}

.section-track {
  flex: 1;
  height: 12rpx;
  overflow: hidden;
  background: #e8edf4;
  border-radius: 6rpx;
}

.section-fill {
  height: 100%;
  background: #1677ff;
  border-radius: 6rpx;
}

.section-percent {
  flex: none;
  width: 92rpx;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
  text-align: right;
  color: #1f2329;
}

.section-foot {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 2rpx 20rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5c667a;
}

/* 项目日志 */
.log {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf1f6;
}

.log-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-title {
  font-size: 28rpx;
  line-height: 1.5;
  color: #1f2329;
  word-break: break-word;
}

.log-date,
.log-author {
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a94a6;
}

.log-toggle {
  margin-left: 20rpx;
  color: #1677ff;
}

.log-body {
  margin-top: 10rpx;
}

.log-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #1f2329;
  white-space: pre-wrap;
  word-break: break-word;
}

.log-risk {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #8a5300;
  background: #fff4e0;
  border-radius: 10rpx;
  word-break: break-word;
}

.log-photos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 12rpx;
}

.log-photo {
  width: 100%;
  height: 190rpx;
  background: #eef1f5;
  border-radius: 10rpx;
}

.log-fold {
  margin-top: 16rpx;
  padding-top: 16rpx;
  font-size: 26rpx;
  text-align: center;
  color: #1677ff;
  border-top: 1rpx solid #edf1f6;
}

/* 财务 */
.finance {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx 16rpx;
  margin-top: 14rpx;
}

.finance-label {
  font-size: 24rpx;
  line-height: 1.5;
  color: #5c667a;
}

.finance-value {
  margin-top: 2rpx;
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.4;
  color: #1f2329;
  word-break: break-all;
}
