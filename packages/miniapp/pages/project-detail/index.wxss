.readonly-tip {
  margin-bottom: 16rpx;
  border: 1px solid #ffd591;
  background: #fff7e6;
  color: #ad6800;
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  font-size: 24rpx;
}

.project-box {
  border: 1px solid #e4e9f2;
  border-radius: 14rpx;
  background: #fff;
  padding: 16rpx;
}

.project-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.project-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5c667a;
}

.section-row {
  border: 1px solid #e4e9f2;
  border-radius: 12rpx;
  background: #fff;
  padding: 14rpx;
  margin-bottom: 12rpx;
}

.section-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.section-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5c667a;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-item {
  border: 1px solid #e4e9f2;
  border-radius: 12rpx;
  background: #fff;
  padding: 12rpx;
}

.summary-label {
  font-size: 22rpx;
  color: #6e7b91;
}

.summary-value {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.empty-tip {
  color: #8a94a7;
  font-size: 24rpx;
}
