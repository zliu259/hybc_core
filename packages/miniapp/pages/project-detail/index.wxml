<view class="page" wx:if="{{pageState === 'ready'}}">
  <!-- 头部：这是哪个项目、走到哪个阶段、谁负责 -->
  <view class="card hero">
    <view class="hero-top">
      <text class="hero-code" user-select="{{true}}">{{project.code}}</text>
      <t-tag theme="{{project.statusTheme}}" variant="light" size="small">{{project.statusText}}</t-tag>
    </view>
    <view class="hero-name">{{project.name}}</view>

    <view class="stages stages-{{project.status}}">
      <view wx:for="{{stages}}" wx:key="key" class="stage stage-{{item.state}}">
        <view class="stage-bar"></view>
        <text class="stage-label">{{item.label}}</text>
      </view>
    </view>

    <view class="kv" wx:for="{{facts}}" wx:key="label">
      <text class="k">{{item.label}}</text>
      <text class="v" user-select="{{true}}">{{item.value}}</text>
    </view>

    <view wx:if="{{readonly}}" class="readonly-note">你只能查看这个项目，不能填写日志</view>
    <view wx:if="{{canWriteLog}}" class="hero-action" hover-class="hero-action-hover" aria-role="button" bindtap="goCreateManagerLog">写项目日志</view>
  </view>

  <view class="card">
    <view class="card-title">项目交底</view>
    <view wx:if="{{briefing.mode === 'rows'}}" class="briefing-rows">
      <block wx:for="{{briefing.rows}}" wx:key="key">
        <view wx:if="{{item.label}}" class="kv">
          <text class="k">{{item.label}}</text>
          <text class="v" user-select="{{true}}">{{item.value}}</text>
        </view>
        <text wx:else class="briefing-plain" user-select="{{true}}">{{item.value}}</text>
      </block>
    </view>
    <text wx:elif="{{briefing.mode === 'text'}}" class="briefing-text" user-select="{{true}}">{{briefing.text}}</text>
    <view wx:else class="card-empty">还没有填写项目交底</view>
  </view>

  <view wx:if="{{canReview}}" class="card link-row" bindtap="openExternalLogReview">
    <text class="link-title">外部日志复核</text>
    <text class="link-value {{externalReviewCount > 0 ? 'link-value-alert' : ''}}">{{externalReviewCount > 0 ? externalReviewCount + ' 条待处理' : '没有待处理'}}<text class="chevron">›</text></text>
  </view>

  <view class="card">
    <view class="card-title">标段进度</view>
    <view wx:if="{{sectionsFailed}}" class="card-empty">标段没有取到，下拉刷新重试</view>
    <view wx:elif="{{sectionCards.length === 0}}" class="card-empty">这个项目还没有标段</view>
    <view wx:for="{{sectionCards}}" wx:key="id" class="section" data-id="{{item.id}}" bindtap="openSectionPage">
      <view class="section-head">
        <text class="section-title">{{item.title}}</text>
        <text class="section-status">{{item.statusText}}<text class="chevron">›</text></text>
      </view>
      <view wx:if="{{item.percent !== null}}" class="section-progress">
        <view class="section-track">
          <view class="section-fill" style="width: {{item.percent}}%"></view>
        </view>
        <text class="section-percent">{{item.percent}}%</text>
      </view>
      <view class="section-foot">
        <text wx:if="{{item.footageText}}">累计 {{item.footageText}}</text>
        <text wx:if="{{item.breakthroughCount > 0}}">贯通报告 {{item.breakthroughCount}} 份</text>
        <text>{{item.latestText}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">项目日志</view>
    <view wx:if="{{logsFailed}}" class="card-empty">项目日志没有取到，下拉刷新重试</view>
    <view wx:elif="{{logs.length === 0}}" class="card-empty">还没有项目日志</view>
    <view wx:for="{{visibleLogs}}" wx:key="id" class="log">
      <view class="log-head" data-id="{{item.id}}" bindtap="toggleLog">
        <view class="log-main">
          <view class="log-title">{{item.title}}</view>
          <view class="log-date">{{item.dayText}}<text class="log-toggle">{{expandedLogId === item.id ? '收起' : '展开'}}</text></view>
        </view>
        <t-tag theme="{{item.statusTheme}}" variant="light" size="small">{{item.statusText}}</t-tag>
      </view>
      <view wx:if="{{expandedLogId === item.id}}" class="log-body">
        <view class="log-author">填报人 {{item.managerName}}</view>
        <text wx:if="{{item.detailText}}" class="log-detail" user-select="{{true}}">{{item.detailText}}</text>
        <view wx:if="{{item.riskNote}}" class="log-risk">风险提示：{{item.riskNote}}</view>
        <view wx:if="{{item.photos.length > 0}}" class="log-photos">
          <image
            wx:for="{{item.photos}}"
            wx:for-item="photo"
            wx:key="url"
            class="log-photo"
            mode="aspectFill"
            src="{{photo.url}}"
            data-logid="{{item.id}}"
            data-current="{{photo.url}}"
            bindtap="previewLogPhoto"
          />
        </view>
      </view>
    </view>
    <view wx:if="{{hiddenLogCount > 0}}" class="log-fold" bindtap="toggleAllLogs">
      {{logsExpanded ? '收起' : '展开其余 ' + hiddenLogCount + ' 条'}}
    </view>
  </view>

  <view class="card">
    <view class="card-title">财务摘要</view>
    <view wx:if="{{financeFailed}}" class="card-empty">财务摘要没有取到，下拉刷新重试</view>
    <view wx:else class="finance">
      <view wx:for="{{financeRows}}" wx:key="label" class="finance-item">
        <view class="finance-label">{{item.label}}</view>
        <view class="finance-value">{{item.value}}</view>
      </view>
    </view>
  </view>
</view>

<view wx:elif="{{pageState === 'error'}}" class="page">
  <view class="card state">
    <view class="state-text">{{loadError}}</view>
    <t-button size="small" variant="outline" wx:if="{{projectId}}" bindtap="loadData">重试</t-button>
  </view>
</view>

<view wx:else class="page">
  <view class="card state">
    <view class="state-text">正在加载项目</view>
  </view>
</view>
