.review-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 30rpx 28rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #243b53 0%, #2f6c5f 100%);
  box-shadow: 0 16rpx 36rpx rgba(36, 59, 83, 0.2);
}

.hero-kicker {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-title {
  margin-top: 6rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.82);
}

.hero-count {
  flex: 0 0 auto;
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.16);
}

.count-value {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 800;
}

.count-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
}

.toolbar {
  margin: 18rpx 0;
}

.review-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1px solid #dbe8f7;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
}

.card-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6b7a90;
}

.status-chip {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff7ea;
  color: #b26a00;
  font-size: 22rpx;
}

.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx 12rpx;
  margin-top: 16rpx;
}

.meta-item {
  min-width: 0;
  font-size: 22rpx;
  color: #6b7a90;
}

.ai-box,
.content-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f8fbff;
  border: 1px solid #dbe8f7;
}

.ai-box {
  background: #fff7ea;
  border-color: #ffd99a;
}

.section-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #1f2329;
}

.section-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.48;
  color: #44546a;
}

.issue-list {
  margin-top: 12rpx;
}

.issue-item {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.42;
  color: #a24300;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}
