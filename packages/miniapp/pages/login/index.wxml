<view class="page">
  <view class="login-shell">
    <view class="brand-block">
      <image src="/assets/login/hybclogo.png" class="logo" mode="widthFix" />
      <view class="brand-title">恒越百川</view>
      <view class="brand-subtitle">员工平台</view>
    </view>

    <view class="login-card">
      <view class="card-title">欢迎登录</view>
      <view class="card-subtitle">请通过企业微信完成身份验证</view>

      <button class="wecom-btn" bindtap="retryLogin" disabled="{{loading}}" loading="{{loading}}">
        <image src="/assets/login/wecom-login-btn.png" mode="widthFix" class="wecom-btn-image" />
      </button>

      <view wx:if="{{errorMessage}}" class="error-box">
        <view class="error-title">登录失败</view>
        <view class="error-text">{{errorMessage}}</view>
        <view class="error-actions">
          <t-button class="btn" size="small" variant="outline" bindtap="copyError">复制错误信息</t-button>
          <t-button class="btn" size="small" variant="outline" bindtap="openProfile">前往我的页面</t-button>
        </view>
      </view>
    </view>
  </view>
</view>
