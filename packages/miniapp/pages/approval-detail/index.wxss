@import "../../styles/detail-cards.wxss";

/* 底部栏最高约 输入框 + 按钮，内容要能滚出来 */
.detail-page.has-footer {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

/* 报销单据 */
.biz-item {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf1f6;
}

.biz-item-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.biz-item-no {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  word-break: break-all;
}

.biz-item-amount {
  flex: none;
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: #1f2329;
}

/* 支付方案 */
.payout-summary {
  font-size: 26rpx;
  line-height: 1.55;
  color: #1f2329;
  word-break: break-word;
}

.field-label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #5c667a;
}

.picker-value {
  margin-top: 6rpx;
  min-height: 72rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #dbe2ea;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #fff;
  font-size: 26rpx;
  line-height: 1.5;
  color: #1f2329;
}

.payout-save {
  margin-top: 16rpx;
}

/* 只借用搜索弹层（fixed 定位不受这里影响），字段本身不占位 */
.transfer-host {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
}

/* 底部决策栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e5ebf3;
  background: #ffffff;
}

/* 键盘弹起时贴着键盘，不再留安全区 */
.footer-bar.is-typing {
  padding-bottom: 14rpx;
}

.comment-error {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #d54941;
}

.comment-input {
  width: 100%;
  height: 72rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #dbe2ea;
  border-radius: 12rpx;
  box-sizing: border-box;
  background: #f7f9fb;
  font-size: 26rpx;
  line-height: 1.5;
  color: #1f2329;
}

.comment-input.is-open {
  height: 148rpx;
  background: #ffffff;
}

.comment-input.is-error {
  border-color: #d54941;
}

.comment-placeholder {
  color: #8a94a6;
}

.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.quick-chip {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background: #eef3f8;
  font-size: 24rpx;
  line-height: 1.5;
  color: #1f2329;
}

.action-row {
  display: flex;
  gap: 12rpx;
}

.comment-input + .action-row,
.quick-row + .action-row {
  margin-top: 12rpx;
}

.action-cell {
  flex: 1;
  min-width: 0;
}

.action-cell-main {
  flex: 2;
}

.footer-acted {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
}

.acted-hint {
  font-size: 26rpx;
  text-align: center;
  color: #2ba471;
}
