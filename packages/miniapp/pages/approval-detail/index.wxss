.detail-content {
  padding-bottom: 180rpx;
}

.section-wrap {
  border-radius: 18rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid #e8edf3;
}

.section-summary {
  background: linear-gradient(180deg, #f5f9ff, #ffffff);
}

.section-biz {
  background: linear-gradient(180deg, #f7fdf8, #ffffff);
}

.section-attachment {
  background: linear-gradient(180deg, #fff9f3, #ffffff);
}

.section-ai {
  background: linear-gradient(180deg, #fff6f8, #ffffff);
}

.section-ai-report {
  background: linear-gradient(180deg, #fff8f4, #ffffff);
}

.section-flow {
  background: linear-gradient(180deg, #f7f8ff, #ffffff);
}

.section-op {
  background: linear-gradient(180deg, #f8f9fb, #ffffff);
}

.section-wrap::after {
  content: "";
  display: block;
  height: 1rpx;
  background: #e9eef5;
  margin: 6rpx 18rpx 0;
}

.meta-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
  margin: 4rpx 0 8rpx;
}

.reject-reason {
  margin: 4rpx 0 2rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #d54941;
}

.kv-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 8rpx;
}

.dot {
  font-size: 26rpx;
  line-height: 1;
  margin-top: 2rpx;
}

.dot-blue {
  color: #246bff;
}

.dot-indigo {
  color: #5e6ad2;
}

.dot-green {
  color: #2ba471;
}

.dot-orange {
  color: #d97706;
}

.dot-gray {
  color: #8a97a8;
}

.dot-sky {
  color: #0ea5e9;
}

.k {
  min-width: 120rpx;
  color: #5b6778;
  font-size: 24rpx;
  line-height: 1.5;
}

.v {
  flex: 1;
  color: #1f2d3d;
  font-size: 24rpx;
  line-height: 1.5;
}

.v-strong {
  font-weight: 700;
  color: #b45309;
}

.attach-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}

.attach-name {
  flex: 1;
  font-size: 24rpx;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-item,
.node-item,
.task-item {
  margin-top: 10rpx;
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
}

.alt-even {
  background: #ffffff;
  border: 1rpx solid #edf2f8;
}

.alt-odd {
  background: #f8fbff;
  border: 1rpx solid #e6eef8;
}

.task-even {
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid #edf2f7;
}

.task-odd {
  background: rgba(246, 250, 255, 0.95);
  border: 1rpx solid #e7eef7;
}

.node-title {
  font-weight: 600;
  color: #1f2d3d;
}

.ai-report-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  font-weight: 500;
  color: #1f2d3d;
}

.ai-report-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #5b6778;
}

.ai-report-label-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #5b6778;
}

.ai-report-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #1f2d3d;
}

.ai-report-line {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 6rpx;
}

.ai-report-line-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: #1f2d3d;
}

.ai-report-row {
  margin-top: 10rpx;
  border-radius: 12rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
}

.ai-report-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.ai-report-row-title {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #1f2d3d;
  word-break: break-all;
}

.ai-report-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a97a8;
}

.ai-report-raw {
  margin-top: 10rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
  font-size: 22rpx;
  line-height: 1.6;
  color: #5b6778;
  word-break: break-all;
  white-space: pre-wrap;
}

.comment-box {
  width: 100%;
  min-height: 120rpx;
  border: 1rpx solid #dbe2ea;
  border-radius: 14rpx;
  padding: 12rpx;
  box-sizing: border-box;
  margin-top: 8rpx;
  background: #fff;
}

.picker-value {
  margin-top: 8rpx;
  min-height: 68rpx;
  border: 1rpx solid #dbe2ea;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  background: #fff;
  color: #1f2d3d;
  font-size: 24rpx;
  line-height: 1.5;
}

.section-divider {
  height: 1rpx;
  background: #e9eef5;
  margin: 12rpx 0;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.footer-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e5ebf3;
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.footer-row {
  display: flex;
  width: 100%;
  align-items: stretch;
  height: 84rpx;
}

.footer-col {
  flex: 0 0 auto;
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.footer-col + .footer-col {
  padding-left: 10rpx;
}

.col-40 {
  width: 40%;
  max-width: 40%;
}

.col-100 {
  width: 100%;
  max-width: 100%;
}

.col-20 {
  width: 20%;
  max-width: 20%;
}

.footer-cell {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: stretch;
}

.footer-cell-outline {
  border: 1rpx solid #b7c4d6;
  border-radius: 12rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.action-btn {
  width: 100%;
  min-width: 0;
}

.action-btn-outline {
  background: transparent;
}

.flow-toggle-row {
  margin: 6rpx 0 10rpx;
}

.loading-wrap,
.empty-wrap {
  padding: 40rpx 0;
}

.footer-acted {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
}

.acted-hint {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.acted-hint-text {
  font-size: 28rpx;
  color: #67c23a;
  font-weight: 500;
}
