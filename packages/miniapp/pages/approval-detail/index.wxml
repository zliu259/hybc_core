<view class="page detail-page {{footerMode ? 'has-footer' : ''}}" wx:if="{{detailState === 'ready' && hero}}">
  <!-- 头部：版式取自付款凭证，先看多少钱、干什么用 -->
  <view class="card hero">
    <view class="hero-head">
      <text class="hero-label">{{hero.amountLabel || hero.bizTypeLabel}}</text>
      <t-tag theme="{{hero.statusTheme}}" variant="light" size="small">{{hero.statusText}}</t-tag>
    </view>
    <block wx:if="{{hero.amountText}}">
      <view class="voucher-amount">{{hero.amountText}}<text class="voucher-unit">元</text></view>
      <view class="voucher-upper">{{hero.amountUpper}}</view>
    </block>
    <view class="hero-title">{{hero.title}}</view>
    <view class="stop-notice {{stopIsReturned ? 'stop-returned' : ''}}" wx:if="{{stopReasonText}}">{{stopReasonText}}</view>
    <view class="kv" wx:for="{{hero.facts}}" wx:key="label">
      <text class="k">{{item.label}}</text>
      <text class="v">{{item.value}}</text>
    </view>
    <view class="hero-foot">
      <text wx:if="{{hero.waitText}}" class="hero-wait">{{hero.waitText}}</text>
      <text class="hero-no">{{hero.amountText ? hero.bizTypeLabel + ' · ' : ''}}{{hero.bizNo}}</text>
    </view>
  </view>

  <!-- AI 审查：先判定和一句话，再列需要人关注的项 -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">AI 审查</text>
      <t-tag wx:if="{{ai.latest && ai.latest.verdictLabel !== '-'}}" theme="{{ai.latest.verdictTheme}}" variant="light" size="small">{{ai.latest.verdictLabel}}</t-tag>
    </view>
    <block wx:if="{{ai.latest}}">
      <!-- 没读完附件时结论可能不成立，告警排在结论之前 -->
      <view class="coverage-alert" wx:if="{{ai.latest.coverage.incomplete}}">
        <view class="coverage-title">{{ai.latest.coverage.title}}</view>
        <view class="coverage-row" wx:for="{{ai.latest.coverage.rows}}" wx:key="key">{{item.text}}</view>
      </view>
      <view class="ai-summary">{{ai.latest.summary}}</view>
      <view class="ai-note" wx:if="{{ai.latest.commentFallback}}">{{ai.latest.commentFallback}}</view>
      <view class="ai-error" wx:if="{{ai.latest.errorText}}">{{ai.latest.errorText}}</view>
      <view class="ai-note" wx:if="{{ai.latest.coverage && !ai.latest.coverage.incomplete}}">{{ai.latest.coverage.text}}</view>

      <view class="finding" wx:for="{{ai.latest.concerns}}" wx:key="key">
        <view class="finding-head">
          <t-tag theme="{{item.statusTheme}}" variant="light" size="small">{{item.statusLabel}}</t-tag>
          <text class="finding-title">{{item.dimensionLabel}}</text>
        </view>
        <view class="finding-text" wx:if="{{item.detail}}">{{item.detail}}</view>
        <view class="finding-evidence" wx:if="{{item.evidence}}">{{item.evidence}}</view>
      </view>

      <block wx:if="{{ai.latest.recommendations.length > 0}}">
        <view class="sub-title">建议</view>
        <view class="bullet" wx:for="{{ai.latest.recommendations}}" wx:key="key">{{item.text}}</view>
      </block>

      <view class="fold-link" wx:if="{{ai.latest.passed.length > 0}}" bindtap="toggleAiPassed">{{aiPassedOpen ? '收起' : '另有 ' + ai.latest.passed.length + ' 项未见异常'}}</view>
      <block wx:if="{{aiPassedOpen}}">
        <view class="finding" wx:for="{{ai.latest.passed}}" wx:key="key">
          <view class="finding-head">
            <t-tag theme="success" variant="light" size="small">{{item.statusLabel}}</t-tag>
            <text class="finding-title">{{item.dimensionLabel}}</text>
          </view>
          <view class="finding-text" wx:if="{{item.detail}}">{{item.detail}}</view>
        </view>
      </block>
    </block>
    <view class="ai-note" wx:elif="{{!aiReportTitle}}">这笔审批没有经过 AI 审查，请人工核对。</view>

    <block wx:if="{{aiReportTitle}}">
      <view class="fold-row" bindtap="toggleAiReport">
        <text class="fold-title">{{aiReportTitle}}</text>
        <text class="fold-action">{{aiReportOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{aiReportOpen && aiBizReport}}">
        <view class="ai-note" wx:if="{{aiBizReport.placeholder}}">{{aiBizReport.placeholder}}</view>
        <block wx:else>
          <view class="ai-note" wx:if="{{aiBizReport.pendingHint}}">{{aiBizReport.pendingHint}}</view>
          <view class="tag-row" wx:if="{{aiBizReport.overallRiskLabel || aiBizReport.scoreText}}">
            <t-tag wx:if="{{aiBizReport.overallRiskLabel}}" theme="{{aiBizReport.overallRiskTheme}}" variant="light" size="small">整体风险：{{aiBizReport.overallRiskLabel}}</t-tag>
            <t-tag wx:if="{{aiBizReport.scoreText}}" theme="{{aiBizReport.scoreTheme}}" variant="light" size="small">{{aiBizReport.scoreText}}</t-tag>
          </view>
          <view class="report-text" wx:if="{{aiBizReport.summary}}">{{aiBizReport.summary}}</view>

          <block wx:if="{{aiBizReport.scoreBasisRows.length > 0}}">
            <view class="sub-title">分数构成</view>
            <view class="bullet" wx:for="{{aiBizReport.scoreBasisRows}}" wx:key="key">{{item.text}}</view>
          </block>

          <block wx:if="{{aiBizReport.clauseRows.length > 0}}">
            <view class="sub-title">条款审查</view>
            <view class="finding" wx:for="{{aiBizReport.clauseRows}}" wx:key="key">
              <view class="finding-head">
                <t-tag theme="{{item.riskTheme}}" variant="light" size="small">风险{{item.riskLabel}}</t-tag>
                <text class="finding-title">{{item.clause}}</text>
              </view>
              <view class="finding-text" wx:if="{{item.issue}}">{{item.issue}}</view>
              <view class="finding-evidence" wx:if="{{item.suggestion}}">修改建议：{{item.suggestion}}</view>
            </view>
          </block>

          <block wx:if="{{aiBizReport.findingRows.length > 0}}">
            <view class="sub-title">检查发现</view>
            <view class="finding" wx:for="{{aiBizReport.findingRows}}" wx:key="key">
              <view class="finding-head">
                <t-tag theme="{{item.statusTheme}}" variant="light" size="small">{{item.statusLabel}}</t-tag>
                <text class="finding-title">{{item.dimensionLabel}}</text>
              </view>
              <view class="finding-text" wx:if="{{item.detail}}">{{item.detail}}</view>
              <view class="finding-evidence" wx:if="{{item.evidence}}">{{item.evidence}}</view>
            </view>
          </block>

          <block wx:if="{{aiBizReport.amountAssessment}}">
            <view class="sub-title">
              <text>金额合理性</text>
              <t-tag wx:if="{{aiBizReport.amountAssessment.riskLabel}}" theme="{{aiBizReport.amountAssessment.riskTheme}}" variant="light" size="small">{{aiBizReport.amountAssessment.riskLabel}}</t-tag>
            </view>
            <view class="report-text" wx:if="{{aiBizReport.amountAssessment.basis}}">{{aiBizReport.amountAssessment.basis}}</view>
            <view class="bullet" wx:for="{{aiBizReport.amountAssessment.riskPointRows}}" wx:key="key">{{item.text}}</view>
          </block>

          <block wx:if="{{aiBizReport.recommendationRows.length > 0}}">
            <view class="sub-title">处理建议</view>
            <view class="bullet" wx:for="{{aiBizReport.recommendationRows}}" wx:key="key">{{item.text}}</view>
          </block>

          <block wx:if="{{aiBizReport.rawFallback}}">
            <view class="sub-title">AI 返回了非标准结构，以下为原始结果</view>
            <view class="report-raw">{{aiBizReport.rawFallback}}</view>
          </block>
          <view class="ai-note" wx:elif="{{aiBizReport.emptyHint}}">{{aiBizReport.emptyHint}}</view>
        </block>
      </block>
      <block wx:if="{{aiReportOpen && detailAuditView}}">
        <view class="tag-row">
          <t-tag theme="{{detailAuditView.statusTheme}}" variant="light" size="small">{{detailAuditView.statusLabel}}</t-tag>
        </view>
        <view class="report-raw" wx:if="{{detailAuditView.reportText}}">{{detailAuditView.reportText}}</view>
        <view class="ai-note" wx:else>暂无审计报告</view>
      </block>
    </block>

    <block wx:if="{{ai.earlier.length > 0}}">
      <view class="fold-row" bindtap="toggleAiEarlier">
        <text class="fold-title">此前 {{ai.earlier.length}} 次审查结论</text>
        <text class="fold-action">{{aiEarlierOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{aiEarlierOpen}}">
        <view class="finding" wx:for="{{ai.earlier}}" wx:key="key">
          <view class="finding-head">
            <t-tag wx:if="{{item.verdictLabel !== '-'}}" theme="{{item.verdictTheme}}" variant="light" size="small">{{item.verdictLabel}}</t-tag>
            <text class="finding-title">{{item.nodeLabel}}</text>
          </view>
          <view class="finding-text">{{item.summary}}</view>
          <view class="finding-warn" wx:if="{{item.coverageIncomplete}}">这次 AI 没有读完附件</view>
          <view class="finding-evidence">{{item.completedAtText}}</view>
        </view>
      </block>
    </block>
  </view>

  <!-- 明细 -->
  <view class="card" wx:if="{{detailRows.length > 0}}">
    <view class="card-head"><text class="card-title">{{detailTitle}}</text></view>
    <view class="kv" wx:for="{{detailRows}}" wx:key="label">
      <text class="k">{{item.label}}</text>
      <text class="v {{item.multiline ? 'v-multiline' : ''}}" user-select="{{true}}">{{item.value}}</text>
    </view>

    <view class="biz-item" wx:for="{{reimbursementItemRows}}" wx:key="id">
      <view class="biz-item-head">
        <text class="biz-item-no">{{item.envelope_no}}</text>
        <text class="biz-item-amount">{{item.amountText}}</text>
      </view>
      <view class="kv" wx:if="{{item.invoice_no}}"><text class="k">发票号</text><text class="v">{{item.invoice_no}}</text></view>
      <view class="kv"><text class="k">AI 结论</text><text class="v">{{item.aiReasonabilitySummary}}</text></view>
      <view class="kv" wx:if="{{item.invoiceRiskLabel}}">
        <text class="k">票据风险</text>
        <t-tag theme="{{item.invoiceRiskTheme}}" variant="light" size="small">{{item.invoiceRiskLabel}}</t-tag>
      </view>
      <view class="attach-row" wx:for="{{item.attachments}}" wx:for-item="file" wx:key="file_key" data-key="{{file.file_key}}" data-name="{{file.file_name}}" bindtap="openAttachment">
        <text class="attach-ext">{{file.extLabel}}</text>
        <text class="attach-name">{{file.file_name}}</text>
        <text class="attach-size" wx:if="{{file.sizeText}}">{{file.sizeText}}</text>
        <text class="fold-action">查看</text>
      </view>
    </view>

    <block wx:if="{{remarkEdits.length > 0}}">
      <view class="fold-row" bindtap="toggleRemarkEdits">
        <text class="fold-title">支付信息修改记录（{{remarkEdits.length}} 条）</text>
        <text class="fold-action">{{remarkEditsOpen ? '收起' : '展开'}}</text>
      </view>
      <block wx:if="{{remarkEditsOpen}}">
        <view class="edit-row" wx:for="{{remarkEdits}}" wx:key="key">
          <view class="edit-meta">{{item.atText}} · {{item.byText}}</view>
          <view class="edit-note">{{item.note}}</view>
        </view>
      </block>
    </block>
  </view>

  <!-- 支付方案：默认一行摘要，要改才展开 -->
  <view class="card" wx:if="{{payoutVisible}}">
    <view class="card-head" bindtap="togglePayoutEditor">
      <text class="card-title">支付方案</text>
      <text class="fold-action">{{payoutEditorOpen ? '收起' : '修改'}}</text>
    </view>
    <view class="payout-summary" wx:if="{{!payoutEditorOpen}}">{{payoutSummary}}</view>
    <block wx:else>
      <view class="field-label">支付方式</view>
      <picker mode="selector" range="{{paymentMethodLabelOptions}}" value="{{paymentMethodIndex}}" bindchange="onPaymentMethodChange">
        <view class="picker-value">{{paymentMethodLabelOptions[paymentMethodIndex]}}</view>
      </picker>
      <view class="field-label">付款主体</view>
      <picker mode="selector" range="{{paymentEntityLabels}}" value="{{paymentEntityIndex}}" bindchange="onPaymentEntityChange">
        <view class="picker-value">{{paymentEntityLabels[paymentEntityIndex]}}</view>
      </picker>
      <view class="field-label">付款账户</view>
      <picker mode="selector" range="{{paymentAccountLabels}}" value="{{paymentAccountIndex}}" bindchange="onPaymentAccountChange">
        <view class="picker-value">{{paymentAccountLabels[paymentAccountIndex]}}</view>
      </picker>
      <view class="payout-save">
        <t-button size="small" variant="outline" disabled="{{acting || !payoutDirty}}" loading="{{pendingAction === 'save_payout'}}" bindtap="onSavePaymentSelection">保存支付方案</t-button>
      </view>
    </block>
  </view>

  <!-- 附件 -->
  <view class="card" wx:if="{{detailAttachments.length > 0}}">
    <view class="card-head"><text class="card-title">附件（{{detailAttachments.length}}）</text></view>
    <view class="attach-row" wx:for="{{detailAttachments}}" wx:key="file_key" data-key="{{item.file_key}}" data-name="{{item.file_name}}" bindtap="openAttachment">
      <text class="attach-ext">{{item.extLabel}}</text>
      <text class="attach-name">{{item.file_name}}</text>
      <text class="attach-size" wx:if="{{item.sizeText}}">{{item.sizeText}}</text>
      <text class="fold-action">查看</text>
    </view>
  </view>

  <!-- 审批流程 -->
  <view class="card" wx:if="{{detailTimelineNodes.length > 0}}">
    <view class="card-head" bindtap="toggleFlowCollapse">
      <text class="card-title">审批流程</text>
      <text class="fold-action">{{flowCollapsed ? '展开' : '收起'}}</text>
    </view>
    <block wx:if="{{!flowCollapsed}}">
      <view class="flow-node" wx:for="{{detailTimelineNodes}}" wx:key="id">
        <view class="flow-node-head">
          <text class="flow-node-name">{{item.node_name}}</text>
          <t-tag theme="{{item.statusTheme}}" variant="light" size="small">{{item.statusLabel}}</t-tag>
        </view>
        <view class="flow-task" wx:for="{{item.tasks}}" wx:for-item="task" wx:key="id">
          <view class="flow-task-line">
            <text class="flow-task-who">{{task.assigneeLabel}}</text>
            <text class="flow-task-action">{{task.actionLabel}}</text>
          </view>
          <view class="flow-task-time" wx:if="{{task.actedAtText}}">{{task.actedAtText}}</view>
          <view class="flow-task-comment" wx:if="{{task.showComment}}">{{task.commentBrief}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 转办人选择：字段本身不显示，由「更多 → 转办」打开它的搜索弹层 -->
  <view class="transfer-host" wx:if="{{canTransfer}}">
    <hy-search-picker id="transferPicker" range="{{transferLabels}}" value="{{0}}" title="转办给" bindchange="onTransferPick" />
  </view>

  <!-- 底部决策栏：通过是主路径，意见可空；驳回、退回未写原因时就地报错 -->
  <view class="footer-bar {{keyboardHeight ? 'is-typing' : ''}}" style="bottom: {{keyboardHeight}}px" wx:if="{{footerMode === 'decide'}}">
    <view class="comment-error" wx:if="{{commentError}}">{{commentError}}</view>
    <textarea
      class="comment-input {{commentFocused || actionComment ? 'is-open' : ''}} {{commentError ? 'is-error' : ''}}"
      value="{{actionComment}}"
      focus="{{commentFocus}}"
      fixed="{{true}}"
      adjust-position="{{false}}"
      show-confirm-bar="{{false}}"
      maxlength="1000"
      placeholder="审批意见（通过时可不填，记为「同意」）"
      placeholder-class="comment-placeholder"
      bindinput="onCommentInput"
      bindfocus="onCommentFocus"
      bindblur="onCommentBlur"
      bindkeyboardheightchange="onKeyboardHeightChange"
    />
    <view class="quick-row" wx:if="{{commentFocused}}">
      <view class="quick-chip" wx:for="{{quickComments}}" wx:key="*this" data-text="{{item}}" bindtap="onQuickComment">{{item}}</view>
    </view>
    <view class="action-row">
      <view class="action-cell" wx:if="{{moreActions.length > 0}}">
        <t-button variant="outline" block disabled="{{acting}}" bindtap="onMoreAction">更多</t-button>
      </view>
      <view class="action-cell" wx:if="{{canReturn}}">
        <t-button variant="outline" block disabled="{{acting}}" loading="{{pendingAction === 'return'}}" bindtap="onReturn">退回</t-button>
      </view>
      <view class="action-cell" wx:if="{{canReject}}">
        <t-button theme="danger" variant="outline" block disabled="{{acting}}" loading="{{pendingAction === 'reject'}}" bindtap="onReject">驳回</t-button>
      </view>
      <view class="action-cell action-cell-main" wx:if="{{canApprove}}">
        <t-button theme="primary" block disabled="{{acting}}" loading="{{pendingAction === 'approve'}}" bindtap="onApprove">通过</t-button>
      </view>
    </view>
  </view>

  <view class="footer-bar" wx:if="{{footerMode === 'manage'}}">
    <view class="action-row">
      <view class="action-cell" wx:for="{{manageActions}}" wx:key="action">
        <t-button variant="outline" block disabled="{{acting}}" loading="{{pendingAction === item.action}}" data-action="{{item.action}}" bindtap="onManageAction">{{item.label}}</t-button>
      </view>
    </view>
  </view>

  <view class="footer-bar" wx:if="{{footerMode === 'edit'}}">
    <t-button theme="primary" block disabled="{{acting}}" bindtap="goEditReturnedBusiness">编辑并重新提交</t-button>
  </view>

  <view class="footer-bar footer-acted" wx:if="{{footerMode === 'acted'}}">
    <view class="acted-hint">您已完成本条审批操作</view>
    <t-button theme="primary" variant="outline" block bindtap="goToPendingList">返回我的待审批</t-button>
  </view>
</view>

<view wx:if="{{detailState === 'loading'}}" class="page skeleton-page">
  <view class="skeleton-card" wx:for="{{[0, 1, 2]}}" wx:key="*this">
    <view class="skeleton-line skeleton-title"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line"></view>
    <view class="skeleton-line skeleton-short"></view>
  </view>
  <view class="skeleton-hint">
    <t-loading theme="dots" size="40rpx" />
    <text class="skeleton-hint-text">加载审批详情中…</text>
  </view>
</view>

<view wx:if="{{detailState === 'error'}}" class="empty-wrap">
  <t-empty description="{{detailErrorText || '审批详情不存在或无权限'}}" />
</view>
