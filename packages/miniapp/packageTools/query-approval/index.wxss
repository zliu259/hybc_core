.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.search-input {
  flex: 1;
  height: 84rpx;
  font-size: 28rpx;
}

.search-clear {
  flex: none;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #1677ff;
}

/* 横向滚动用 inline-block，不用 enable-flex：flex 模式下标签会被拉满整屏高度 */
.chips {
  width: 100%;
  height: 60rpx;
  margin-top: 20rpx;
  white-space: nowrap;
}

.chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #5c667a;
  background: #fff;
  border-radius: 999rpx;
}

.chip-active {
  font-weight: 600;
  color: #fff;
  background: #1677ff;
}

.filters {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.filter {
  flex: 1;
  min-width: 0;
}

/* 和旁边的搜索选择器同高同边框 */
.filter-value {
  overflow: hidden;
  box-sizing: border-box;
  min-height: 84rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  line-height: 82rpx;
  color: #1f2329;
  white-space: nowrap;
  text-overflow: ellipsis;
  background: #fff;
  border: 1rpx solid #d8dce5;
  border-radius: 12rpx;
}

.summary {
  min-height: 40rpx;
  margin: 16rpx 4rpx 10rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #5c667a;
}

.state {
  padding: 72rpx 24rpx;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
}

.state-text {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #5c667a;
}

.flow {
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
}

.flow-hover {
  background: #f0f4fa;
}

.flow-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.flow-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
  color: #1f2329;
  word-break: break-word;
}

.flow-tag {
  flex: none;
}

.flow-meta,
.flow-no {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #8a94a6;
  white-space: pre-wrap;
}

.flow-wait {
  margin-top: 8rpx;
  padding: 8rpx 14rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #0b5ed7;
  background: #eaf2ff;
  border-radius: 10rpx;
  word-break: break-word;
}

.list-foot {
  padding: 16rpx 0 8rpx;
  font-size: 24rpx;
  text-align: center;
  color: #8a94a6;
}
