.summary-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.summary-card {
  background: #f7fbff;
  border: 1rpx solid #dbe8f7;
  border-radius: 14rpx;
  padding: 14rpx;
  text-align: center;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #174ea6;
}

.summary-label {
  font-size: 22rpx;
  color: #5c667a;
  margin-top: 6rpx;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.input,
.picker-value {
  flex: 1;
  background: #fff;
  border: 1rpx solid #d7dbe3;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn {
  flex: 1;
}

.empty {
  text-align: center;
  color: #7b8494;
  padding: 24rpx 0;
}

.item-card {
  background: #fff;
  border: 1rpx solid #e7eaf0;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 14rpx;
}

.item-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.item-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  word-break: break-all;
}

.item-sub {
  color: #5c667a;
  font-size: 24rpx;
  margin-top: 4rpx;
}

.item-identifier {
  word-break: break-all;
}

.item-amount {
  margin-top: 6rpx;
  color: #174ea6;
  font-size: 30rpx;
  font-weight: 700;
}

.actions {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}
