<view class="page">
  <hy-panel-card title="我的报销提交" subtitle="列表筛选、继续编辑、状态追踪">
    <view class="summary-row">
      <view class="summary-card">
        <view class="summary-value">{{summary.draft}}</view>
        <view class="summary-label">草稿</view>
      </view>
      <view class="summary-card">
        <view class="summary-value">{{summary.processing}}</view>
        <view class="summary-label">处理中</view>
      </view>
      <view class="summary-card">
        <view class="summary-value">{{summary.done}}</view>
        <view class="summary-label">已完结</view>
      </view>
    </view>

    <view class="toolbar">
      <input class="input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="编号/信封识别号/发票号/摘要" />
      <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusChange">
        <view class="picker-value">{{statusOptions[statusIndex].label}}</view>
      </picker>
    </view>

    <view class="toolbar">
      <t-button class="btn" variant="outline" bindtap="search" loading="{{loading}}">查询</t-button>
      <t-button class="btn btn-primary" theme="primary" bindtap="goCreate">发起报销</t-button>
    </view>

    <view wx:if="{{!list.length && !loading}}" class="empty">暂无报销提交</view>

    <view wx:for="{{list}}" wx:key="id" class="item-card">
      <view class="item-row">
        <text class="item-title">{{item.summaryText}}</text>
        <hy-status-chip text="{{item.statusLabel}}" theme="warning" variant="light" />
      </view>
      <view class="item-sub item-identifier">识别号：{{item.envelope_no}}</view>
      <view wx:if="{{item.envelope_uuid}}" class="item-sub item-identifier">信封识别号：{{item.envelope_uuid}}</view>
      <view class="item-sub">通道：{{item.channelLabel}}</view>
      <view class="item-amount">¥{{item.amountText}}</view>
      <view class="item-sub">更新时间：{{item.updatedAtText}}</view>
      <view class="actions">
        <t-button class="btn" size="small" variant="outline" theme="{{item.actionTheme}}" data-id="{{item.id}}" bindtap="goDetail">{{item.actionLabel}}</t-button>
      </view>
    </view>
  </hy-panel-card>
</view>
