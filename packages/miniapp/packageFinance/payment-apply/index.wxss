.step-indicator {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.step-dot {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 26rpx;
}

.step-dot.on {
  background: #dbeafe;
  color: #1d4ed8;
  font-weight: 600;
}

.step-nav {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.confirm-panel .confirm-row {
  padding: 8rpx 0;
  font-size: 28rpx;
  color: #374151;
}

.amount-wrap {
  background: #f8fbff;
  border: 1rpx solid #dce8f8;
  border-radius: 14rpx;
  padding: 16rpx;
  margin-bottom: 18rpx;
}

.amount-input {
  margin-top: 10rpx;
}

.amount-display {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #49586a;
  font-weight: 600;
}

.threshold-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.threshold-hint.ok {
  color: #117a3f;
}

.threshold-hint.warn {
  color: #b26a00;
}

.section-block {
  margin-top: 18rpx;
  border: 1rpx solid #e4ebf4;
  border-radius: 14rpx;
  padding: 16rpx;
  background: #fff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2d3d;
  margin-bottom: 8rpx;
}

.picker-value {
  border: 1rpx solid #d8dce5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
  background: #fff;
  font-size: 28rpx;
  color: #1f2329;
}

.helper-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b26a00;
}

.textarea {
  min-height: 128rpx;
  border: 1rpx solid #d8dce5;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 12rpx;
  background: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.attachment-empty {
  margin-top: 12rpx;
  color: #7b8494;
  font-size: 24rpx;
}

.attachment-item {
  margin-top: 10rpx;
  border: 1rpx solid #e3e8ef;
  border-radius: 12rpx;
  background: #fdfefe;
  padding: 12rpx;
}

.attachment-name {
  font-size: 26rpx;
  color: #1f2937;
  word-break: break-all;
}

.attachment-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #697789;
}

.mini-btn {
  margin-top: 8rpx;
}

.switch-row {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #334155;
}

.first-payment-box {
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid #dbe8f8;
  background: #f7fbff;
}

.quick-payee-row {
  margin-top: 10rpx;
}

.quick-payee-box {
  border-style: dashed;
  border-color: #cddff5;
  background: #f8fbff;
}

.payee-info-box {
  margin-top: 10rpx;
  padding: 12rpx;
  border: 1rpx solid #d9e8fb;
  border-radius: 12rpx;
  background: #f7fbff;
}

.payee-info-line {
  font-size: 24rpx;
  color: #30445f;
  line-height: 1.7;
  word-break: break-all;
}

.payee-info-line .k {
  color: #50617a;
}

.contract-entry {
  margin-bottom: 18rpx;
}

.contract-entry-body {
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  border: 1rpx dashed #cddff5;
  background: #f8fbff;
}

.contract-entry-hint {
  font-size: 22rpx;
  color: #50617a;
  line-height: 1.6;
}

.contract-entry-toolbar {
  margin-top: 6rpx;
}
