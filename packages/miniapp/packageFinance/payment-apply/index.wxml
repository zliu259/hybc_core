<view class="page">
  <hy-panel-card title="💸 资金流出智能发单台" subtitle="与 Web 智能发单台对齐：阈值识别、直付或合同流程、附件与审批联动">
    <view class="step-indicator">
      <view class="step-dot on">1 金额</view>
      <view class="step-dot {{currentStep >= 1 ? 'on' : ''}}">2 信息</view>
      <view class="step-dot {{currentStep >= 2 ? 'on' : ''}}">3 提交</view>
    </view>

    <view wx:if="{{currentStep === 0}}">
      <view class="amount-wrap">
        <view class="label required">预计付款总额</view>
        <input
          class="input amount-input"
          type="digit"
          value="{{amountInput}}"
          bindinput="onAmountInput"
          placeholder="请输入金额"
          disabled="{{busy || submitting}}"
        />
        <view class="amount-display">{{amountDisplay}}</view>
        <view class="threshold-hint {{exceedsThreshold ? 'warn' : 'ok'}}">
          {{checking ? '阈值校验中...' : (exceedsThreshold ? (directForm.contract_id ? ('金额超过阈值 ' + thresholdLimit + '，已关联现有合同，可直接发起付款') : ('金额超过阈值 ' + thresholdLimit + '，请先关联已审批合同或走新建合同流程')) : ('金额未超过阈值 ' + thresholdLimit + '，可直接走付款申请'))}}
        </view>
      </view>

      <view class="contract-entry">
        <t-button
          class="btn"
          variant="outline"
          bindtap="toggleContractEntry"
          disabled="{{busy || submitting}}"
        >{{contractEntryOpen ? '收起合同选择' : '💼 通过已有合同发起付款'}}</t-button>
        <view wx:if="{{contractEntryOpen}}" class="contract-entry-body">
          <view class="contract-entry-hint">不记得合同号？默认只显示你经办、且仍有可用额度的合同，选中后自动带入付款信息。</view>
          <view class="row contract-entry-toolbar">
            <t-button class="mini-btn" size="small" variant="outline" bindtap="toggleShowAllContracts">
              {{showAllContracts ? '只看我的合同' : '加载全部合同'}}
            </t-button>
          </view>
          <hy-search-picker
            range="{{contractLabels}}"
            value="{{directContractIndex}}"
            title="选择已有合同"
            placeholder="无合同 / 无需合同"
            searchPlaceholder="按对方单位 / 类型 / 经办人搜索"
            emptyText="暂无可用合同"
            bindchange="onContractEntryPick"
          />
          <view wx:if="{{directContractRemainingText}}" class="helper-text">当前合同可用额度：{{directContractRemainingText}}</view>
          <view wx:if="{{visibleContracts.length === 0}}" class="helper-text">暂无{{showAllContracts ? '' : '你经办的'}}可用合同，可点击“加载全部合同”查看他人合同。</view>
        </view>
      </view>
    </view>

    <view hidden="{{currentStep !== 1}}">
    <view wx:if="{{quickPayeeVisible}}" class="section-block quick-payee-box">
      <view class="section-title">快速添加外部收款人</view>

      <view class="label required">收款人名称</view>
      <input
        class="input"
        value="{{quickPayeeForm.name}}"
        data-key="name"
        bindinput="onQuickPayeeInput"
        placeholder="请输入收款人名称"
        disabled="{{busy || submitting || quickPayeeSubmitting}}"
      />

      <view class="label required">开户行</view>
      <input
        class="input"
        value="{{quickPayeeForm.bank_name}}"
        data-key="bank_name"
        bindinput="onQuickPayeeInput"
        placeholder="请输入开户行"
        disabled="{{busy || submitting || quickPayeeSubmitting}}"
      />

      <view class="label required">银行账号</view>
      <input
        class="input"
        value="{{quickPayeeForm.bank_account}}"
        data-key="bank_account"
        bindinput="onQuickPayeeInput"
        placeholder="请输入银行账号"
        disabled="{{busy || submitting || quickPayeeSubmitting}}"
      />

      <view class="label">联系电话</view>
      <input
        class="input"
        value="{{quickPayeeForm.phone}}"
        data-key="phone"
        bindinput="onQuickPayeeInput"
        placeholder="选填"
        disabled="{{busy || submitting || quickPayeeSubmitting}}"
      />

      <view class="row">
        <t-button class="btn" variant="outline" bindtap="closeQuickPayee" disabled="{{quickPayeeSubmitting}}">取消</t-button>
        <t-button class="btn btn-primary" theme="primary" loading="{{quickPayeeSubmitting}}" disabled="{{busy || submitting || quickPayeeSubmitting}}" bindtap="submitQuickPayee">保存并选中</t-button>
      </view>
    </view>

    <view wx:if="{{!shouldUseContractFlow}}" class="section-block">
      <view class="section-title">直付流程（阈值内或关联已审批合同）</view>

      <view class="label">合同（可选）</view>
      <hy-search-picker
        range="{{contractLabels}}"
        value="{{directContractIndex}}"
        title="选择合同"
        placeholder="无合同 / 无需合同"
        searchPlaceholder="按对方单位 / 类型 / 经办人搜索"
        emptyText="暂无可用合同"
        bindchange="onDirectContractChange"
      />
      <view class="row contract-entry-toolbar">
        <t-button class="mini-btn" size="small" variant="outline" bindtap="toggleShowAllContracts">
          {{showAllContracts ? '只看我的合同' : '加载全部合同'}}
        </t-button>
      </view>
      <view wx:if="{{directContractRemainingText}}" class="helper-text">当前合同可用额度：{{directContractRemainingText}}</view>

      <hy-project-picker
        value="{{directProjectValue}}"
        label="所属项目"
        enableGps="{{false}}"
        bind:change="onDirectProjectChange"
      />

      <view class="label required">收款方</view>
      <hy-search-picker
        range="{{payeeLabels}}"
        value="{{directPayeeIndex}}"
        title="选择收款方"
        placeholder="请选择外部收款方"
        searchPlaceholder="按名称 / 拼音 / 开户行搜索"
        emptyText="暂无外部收款方"
        bindchange="onDirectPayeeChange"
      />
      <view wx:if="{{selectedDirectPayee}}" class="payee-info-box">
        <view class="payee-info-line"><text class="k">收款人：</text>{{selectedDirectPayee.name}}</view>
        <view class="payee-info-line"><text class="k">开户行：</text>{{selectedDirectPayee.bank_name}}</view>
        <view class="payee-info-line"><text class="k">银行账号：</text>{{selectedDirectPayee.bank_account}}</view>
        <view class="payee-info-line"><text class="k">联系电话：</text>{{selectedDirectPayee.phone || '-'}}</view>
      </view>
      <view class="row quick-payee-row">
        <t-button
          class="btn"
          variant="outline"
          data-target="direct"
          bindtap="openQuickPayee"
          disabled="{{busy || submitting}}"
        >快速添加外部收款人</t-button>
      </view>

      <view class="label required">付款日期</view>
      <picker mode="date" value="{{directForm.expected_payment_date}}" bindchange="onDirectDateChange">
        <view class="picker-value">{{directForm.expected_payment_date || '请选择日期'}}</view>
      </picker>

      <view class="label required">付款类别</view>
      <picker mode="selector" range="{{directCategoryOptions}}" value="{{directCategoryIndex}}" bindchange="onDirectCategoryChange">
        <view class="picker-value">{{directCategoryOptions[directCategoryIndex]}}</view>
      </picker>

      <view class="label required">付款方式</view>
      <picker mode="selector" range="{{paymentMethodOptions}}" value="{{directPaymentMethodIndex}}" bindchange="onDirectPaymentMethodChange">
        <view class="picker-value">{{paymentMethodOptions[directPaymentMethodIndex]}}</view>
      </picker>

      <view class="label required">付款事由</view>
      <textarea class="textarea" value="{{directForm.content}}" data-key="content" bindinput="onDirectInput" maxlength="200" disabled="{{busy || submitting}}" />

      <view class="label">备注</view>
      <textarea class="textarea" value="{{directForm.remark}}" data-key="remark" bindinput="onDirectInput" maxlength="200" disabled="{{busy || submitting}}" />

      <view class="label required">付款附件</view>
      <view class="row">
        <t-button class="btn" variant="outline" data-group="direct" bindtap="chooseImageAttachment" disabled="{{busy || submitting}}">上传图片</t-button>
        <t-button class="btn" variant="outline" data-group="direct" bindtap="chooseFileAttachment" disabled="{{busy || submitting}}">上传本地文件</t-button>
      </view>

      <view wx:if="{{directPaymentAttachments.length === 0}}" class="attachment-empty">暂无附件</view>
      <view wx:for="{{directPaymentAttachments}}" wx:key="file_key" class="attachment-item">
        <view class="attachment-name">{{item.file_name}}</view>
        <view class="attachment-meta">{{item.file_size || '-'}} bytes</view>
        <t-button class="mini-btn" size="small" variant="outline" data-group="direct" data-index="{{index}}" bindtap="removeAttachment">移除</t-button>
      </view>
    </view>

    <view wx:else class="section-block">
      <view class="section-title">合同流程（超阈值）</view>

      <view class="label">已有关联合同（可选）</view>
      <hy-search-picker
        range="{{contractLabels}}"
        value="{{directContractIndex}}"
        title="选择合同"
        placeholder="无合同 / 无需合同"
        searchPlaceholder="按对方单位 / 类型 / 经办人搜索"
        emptyText="暂无可用合同"
        bindchange="onDirectContractChange"
      />
      <view class="row contract-entry-toolbar">
        <t-button class="mini-btn" size="small" variant="outline" bindtap="toggleShowAllContracts">
          {{showAllContracts ? '只看我的合同' : '加载全部合同'}}
        </t-button>
      </view>
      <view wx:if="{{directContractRemainingText}}" class="helper-text">当前合同可用额度：{{directContractRemainingText}}</view>

      <hy-project-picker
        value="{{contractProjectValue}}"
        label="所属项目"
        enableGps="{{false}}"
        bind:change="onContractProjectChange"
      />

      <view class="label required">我方主体</view>
      <hy-search-picker
        range="{{entityLabels}}"
        value="{{contractEntityIndex}}"
        title="选择我方主体"
        placeholder="请选择我方主体"
        searchPlaceholder="按主体名称 / 拼音搜索"
        emptyText="暂无可选主体"
        bindchange="onContractEntityChange"
      />

      <view class="label required">对方单位</view>
      <hy-search-picker
        range="{{payeeLabels}}"
        value="{{contractPayeeIndex}}"
        title="选择对方单位"
        placeholder="请选择外部收款方"
        searchPlaceholder="按名称 / 拼音 / 开户行搜索"
        emptyText="暂无外部收款方"
        bindchange="onContractPayeeChange"
      />
      <view wx:if="{{selectedContractPayee}}" class="payee-info-box">
        <view class="payee-info-line"><text class="k">收款人：</text>{{selectedContractPayee.name}}</view>
        <view class="payee-info-line"><text class="k">开户行：</text>{{selectedContractPayee.bank_name}}</view>
        <view class="payee-info-line"><text class="k">银行账号：</text>{{selectedContractPayee.bank_account}}</view>
        <view class="payee-info-line"><text class="k">联系电话：</text>{{selectedContractPayee.phone || '-'}}</view>
      </view>
      <view class="row quick-payee-row">
        <t-button
          class="btn"
          variant="outline"
          data-target="contract"
          bindtap="openQuickPayee"
          disabled="{{busy || submitting}}"
        >快速添加外部收款人</t-button>
      </view>

      <view class="label required">经办人</view>
      <picker mode="selector" range="{{wecomUserLabels}}" value="{{contractHandlerIndex}}" bindchange="onContractHandlerChange">
        <view class="picker-value">{{wecomUserLabels[contractHandlerIndex]}}</view>
      </picker>

      <view class="label required">合同日期</view>
      <picker mode="date" value="{{contractForm.contract_date}}" bindchange="onContractDateChange">
        <view class="picker-value">{{contractForm.contract_date || '请选择日期'}}</view>
      </picker>

      <view class="label required">合同类型</view>
      <picker mode="selector" range="{{contractTypeOptions}}" value="{{contractTypeIndex}}" bindchange="onContractTypeChange">
        <view class="picker-value">{{contractTypeOptions[contractTypeIndex]}}</view>
      </picker>

      <view class="label">备注</view>
      <textarea class="textarea" value="{{contractForm.remark}}" data-key="remark" bindinput="onContractInput" maxlength="200" disabled="{{busy || submitting}}" />

      <view class="label required">合同附件</view>
      <view class="row">
        <t-button class="btn" variant="outline" data-group="contract" bindtap="chooseImageAttachment" disabled="{{busy || submitting}}">上传图片</t-button>
        <t-button class="btn" variant="outline" data-group="contract" bindtap="chooseFileAttachment" disabled="{{busy || submitting}}">上传本地文件</t-button>
      </view>

      <view wx:if="{{contractAttachments.length === 0}}" class="attachment-empty">暂无附件</view>
      <view wx:for="{{contractAttachments}}" wx:key="file_key" class="attachment-item">
        <view class="attachment-name">{{item.file_name}}</view>
        <view class="attachment-meta">{{item.file_size || '-'}} bytes</view>
        <t-button class="mini-btn" size="small" variant="outline" data-group="contract" data-index="{{index}}" bindtap="removeAttachment">移除</t-button>
      </view>

      <view class="switch-row">
        <view>同时发起首笔预付款</view>
        <switch checked="{{withFirstPayment}}" bindchange="onFirstPaymentToggle" color="#1677ff" />
      </view>

      <view wx:if="{{withFirstPayment}}" class="first-payment-box">
        <view class="label required">首笔金额</view>
        <input class="input" type="digit" value="{{firstPaymentForm.amount}}" data-key="amount" bindinput="onFirstPaymentInput" disabled="{{busy || submitting}}" />

        <view class="label required">首笔付款类别</view>
        <picker mode="selector" range="{{firstPaymentCategoryOptions}}" value="{{firstPaymentCategoryIndex}}" bindchange="onFirstPaymentCategoryChange">
          <view class="picker-value">{{firstPaymentCategoryOptions[firstPaymentCategoryIndex]}}</view>
        </picker>

        <view class="label required">首笔付款日期</view>
        <picker mode="date" value="{{firstPaymentForm.expected_payment_date}}" bindchange="onFirstPaymentDateChange">
          <view class="picker-value">{{firstPaymentForm.expected_payment_date || '请选择日期'}}</view>
        </picker>

        <view class="label required">首笔付款方式</view>
        <picker mode="selector" range="{{paymentMethodOptions}}" value="{{firstPaymentMethodIndex}}" bindchange="onFirstPaymentMethodChange">
          <view class="picker-value">{{paymentMethodOptions[firstPaymentMethodIndex]}}</view>
        </picker>

        <view class="label required">首笔付款事由</view>
        <textarea class="textarea" value="{{firstPaymentForm.content}}" data-key="content" bindinput="onFirstPaymentInput" maxlength="200" disabled="{{busy || submitting}}" />

        <view class="label">首笔备注</view>
        <textarea class="textarea" value="{{firstPaymentForm.remark}}" data-key="remark" bindinput="onFirstPaymentInput" maxlength="200" disabled="{{busy || submitting}}" />

        <view class="label required">首笔付款附件</view>
        <view class="row">
          <t-button class="btn" variant="outline" data-group="first" bindtap="chooseImageAttachment" disabled="{{busy || submitting}}">上传图片</t-button>
          <t-button class="btn" variant="outline" data-group="first" bindtap="chooseFileAttachment" disabled="{{busy || submitting}}">上传本地文件</t-button>
        </view>

        <view wx:if="{{firstPaymentAttachments.length === 0}}" class="attachment-empty">暂无附件</view>
        <view wx:for="{{firstPaymentAttachments}}" wx:key="file_key" class="attachment-item">
          <view class="attachment-name">{{item.file_name}}</view>
          <view class="attachment-meta">{{item.file_size || '-'}} bytes</view>
          <t-button class="mini-btn" size="small" variant="outline" data-group="first" data-index="{{index}}" bindtap="removeAttachment">移除</t-button>
        </view>
      </view>
    </view>
    </view>

    <view wx:if="{{currentStep === 2}}" class="confirm-panel">
      <view class="section-title">确认提交</view>
      <view class="confirm-row">预计付款总额：¥{{amountDisplay}}</view>
      <view class="confirm-row">流程：{{shouldUseContractFlow ? '合同流程（超阈值）' : '直付流程'}}</view>

      <block wx:if="{{!shouldUseContractFlow}}">
        <view class="confirm-row">所属项目：{{directProjectName || '-'}}</view>
        <view wx:if="{{directForm.contract_id > 0}}" class="confirm-row">关联合同：{{contractLabels[directContractIndex] || '-'}}</view>
        <view class="confirm-row">收款方：{{selectedDirectPayee.name || '-'}}</view>
        <view class="confirm-row">付款日期：{{directForm.expected_payment_date || '-'}}</view>
        <view class="confirm-row">付款类别：{{directForm.category || '-'}}</view>
        <view class="confirm-row">付款方式：{{directForm.payment_method || '-'}}</view>
        <view class="confirm-row">付款事由：{{directForm.content || '-'}}</view>
        <view class="confirm-row">附件：{{directPaymentAttachments.length}} 个</view>
      </block>
      <block wx:else>
        <view class="confirm-row">所属项目：{{contractProjectName || '-'}}</view>
        <view class="confirm-row">我方主体：{{entityLabels[contractEntityIndex] || '-'}}</view>
        <view class="confirm-row">对方单位：{{selectedContractPayee.name || '-'}}</view>
        <view class="confirm-row">合同类型：{{contractForm.contract_type || '-'}}</view>
        <view class="confirm-row">合同日期：{{contractForm.contract_date || '-'}}</view>
        <view class="confirm-row">经办人：{{wecomUserLabels[contractHandlerIndex] || '-'}}</view>
        <view class="confirm-row">附件：{{contractAttachments.length}} 个</view>
        <view class="confirm-row">同时发起首笔预付款：{{withFirstPayment ? '是' : '否'}}</view>
        <block wx:if="{{withFirstPayment}}">
          <view class="confirm-row">首笔金额：{{firstPaymentAmountText || '-'}}</view>
          <view class="confirm-row">首笔付款日期：{{firstPaymentForm.expected_payment_date || '-'}}</view>
          <view class="confirm-row">首笔附件：{{firstPaymentAttachments.length}} 个</view>
        </block>
      </block>

      <view class="row">
        <t-button
          wx:if="{{!shouldUseContractFlow}}"
          class="btn btn-primary"
          theme="primary"
          loading="{{submitting}}"
          disabled="{{busy || submitting}}"
          bindtap="submitDirect"
        >创建付款并提审</t-button>
        <t-button
          wx:else
          class="btn btn-primary"
          theme="primary"
          loading="{{submitting}}"
          disabled="{{busy || submitting}}"
          bindtap="submitContractFlow"
        >创建合同并提审</t-button>
      </view>
    </view>

    <view class="step-nav">
      <t-button wx:if="{{currentStep > 0}}" variant="outline" disabled="{{busy || submitting}}" bindtap="goPrevStep">上一步</t-button>
      <t-button wx:if="{{currentStep < 2}}" theme="primary" disabled="{{busy || submitting}}" bindtap="goNextStep">下一步</t-button>
    </view>

  </hy-panel-card>
</view>
