<view class="page rb-page">
  <view class="rb-verdict">
    <view class="rb-headline {{tone === 'warn' ? 'rb-headline--warn' : ''}}">{{headline}}</view>
    <view wx:if="{{nextStep}}" class="rb-next">{{nextStep}}</view>
  </view>

  <view class="rb-section">
    <view class="rb-section-title">发票和附件</view>
    <view wx:if="{{rows.length === 0}}" class="rb-empty">还没有文件</view>
    <view wx:for="{{rows}}" wx:key="key" class="rb-file">
      <view class="rb-file-line" data-key="{{item.key}}" bindtap="toggleRow">
        <view class="rb-file-name">{{item.name}}</view>
        <view class="rb-file-status {{item.tone === 'warn' ? 'rb-file-status--warn' : ''}}">{{item.statusText}}</view>
      </view>

      <view wx:if="{{item.kind === 'upload' && item.canRetry}}" class="rb-file-detail">
        <view wx:if="{{item.error}}" class="rb-file-error">{{item.error}}</view>
        <view class="rb-file-actions">
          <t-button size="small" variant="outline" data-id="{{item.localId}}" bindtap="retryUpload">重试</t-button>
          <t-button size="small" variant="outline" data-id="{{item.localId}}" bindtap="dismissUpload">移除</t-button>
        </view>
      </view>

      <view wx:if="{{item.duplicateText}}" class="rb-file-error">{{item.duplicateText}}</view>

      <view wx:if="{{item.expanded}}" class="rb-file-detail">
        <view wx:if="{{item.sellerName}}" class="rb-fact"><text class="rb-fact-label">销售方</text>{{item.sellerName}}</view>
        <view wx:if="{{item.invoiceNo}}" class="rb-fact"><text class="rb-fact-label">发票号</text>{{item.invoiceNo}}</view>
        <view wx:if="{{item.invoiceDate}}" class="rb-fact"><text class="rb-fact-label">开票日期</text>{{item.invoiceDate}}</view>
        <view wx:if="{{item.rawTextSummary}}" class="rb-fact"><text class="rb-fact-label">系统读到的内容</text>{{item.rawTextSummary}}</view>
        <view class="rb-file-actions">
          <t-button size="small" variant="outline" data-key="{{item.key}}" bindtap="openAttachment">查看原件</t-button>
          <t-button wx:if="{{item.canRerecognize}}" size="small" variant="outline" data-id="{{item.attachmentId}}" disabled="{{busy}}" bindtap="rerecognizeOne">重新识别</t-button>
          <t-button wx:if="{{item.canDelete}}" size="small" theme="danger" variant="outline" data-id="{{item.attachmentId}}" disabled="{{busy}}" bindtap="removeAttachment">删除</t-button>
        </view>
      </view>
    </view>

    <view wx:if="{{canUpload}}" class="rb-upload">
      <t-button block variant="outline" bindtap="onUploadTap">上传发票（可以一次选多张）</t-button>
      <view class="rb-tip">支持 PDF、JPG、PNG，单个不超过 20MB</view>
    </view>
  </view>

  <view class="rb-section">
    <view wx:if="{{totalsText}}" class="rb-totals">{{totalsText}}</view>
    <view class="rb-label">报销金额</view>
    <input class="rb-input" type="digit" value="{{draft.amount}}" data-key="amount" bindinput="onDraftInput" disabled="{{busy || editLocked}}" placeholder="默认等于已识别的票面合计" />
  </view>

  <view class="rb-section">
    <view class="rb-label">报销通道</view>
    <picker mode="selector" range="{{channelOptions}}" range-key="label" value="{{channelIndex}}" disabled="{{!!latestEnvelopeId}}" bindchange="onChannelChange">
      <view class="rb-input rb-picker">{{channelOptions[channelIndex].label}}</view>
    </picker>

    <block wx:if="{{draft.channel === 'physical'}}">
      <view class="rb-label">信封识别号</view>
      <input class="rb-input" value="{{draft.preferred_envelope_uuid}}" data-key="preferred_envelope_uuid" bindinput="onDraftInput" disabled="{{busy || !!latestEnvelopeId}}" placeholder="扫码或粘贴信封识别号" />
      <t-button wx:if="{{!latestEnvelopeId}}" class="rb-scan" size="small" variant="outline" bindtap="scanQr" disabled="{{busy}}">扫码录入</t-button>
    </block>

    <hy-project-picker value="{{sharedProjectId}}" label="所属项目" enableGps="{{false}}" bind:change="onProjectChange" />

    <view class="rb-label">类别</view>
    <input class="rb-input" value="{{draft.category}}" data-key="category" bindinput="onDraftInput" disabled="{{busy || editLocked}}" />

    <view class="rb-label">说明</view>
    <textarea class="rb-input rb-textarea" value="{{draft.description}}" data-key="description" bindinput="onDraftInput" maxlength="240" disabled="{{busy || editLocked}}" />

    <view class="rb-label">费用日期</view>
    <picker mode="date" value="{{draft.expense_date}}" data-key="expense_date" disabled="{{editLocked}}" bindchange="onDraftInput">
      <view class="rb-input rb-picker">{{draft.expense_date || '请选择日期'}}</view>
    </picker>

    <t-button wx:if="{{!editLocked}}" class="rb-save" size="small" variant="outline" bindtap="saveDraft" disabled="{{busy}}">保存</t-button>
  </view>

  <view class="rb-footer">
    <t-button wx:for="{{actions}}" wx:key="key" block class="rb-action" theme="{{index === 0 ? 'primary' : 'default'}}" variant="{{index === 0 ? 'base' : 'outline'}}" data-key="{{item.key}}" loading="{{busy && index === 0}}" disabled="{{busy || item.disabled}}" bindtap="onGuidanceAction">{{item.label}}</t-button>
    <view class="rb-links">
      <text class="rb-link" bindtap="goMyList">返回我的提交</text>
      <text class="rb-link {{uploading ? 'rb-link--off' : ''}}" bindtap="resetDraft">新建一张</text>
    </view>
  </view>
</view>
