<view class="page">
  <hy-panel-card title="⛽ 油卡额度申请" subtitle="额度、车辆、里程、照片与申请记录">
    <view wx:if="{{needsInfoCount > 0}}" class="notice-warning">
      有 {{needsInfoCount}} 条油卡申请需要补充资料，请在申请记录中点击“补充资料”。
    </view>

    <view class="label required">所用车辆</view>
    <hy-search-picker
      range="{{vehicleLabels}}"
      value="{{vehicleIndex}}"
      title="选择车辆"
      placeholder="请选择车辆"
      searchPlaceholder="输入车牌号 / 车型搜索"
      emptyText="暂无可用车辆"
      disabled="{{!!resubmitApplicationId}}"
      bindchange="onVehicleChange"
    />

    <view class="label required">油卡卡号</view>
    <picker
      mode="selector"
      range="{{fuelCardLabels}}"
      value="{{fuelCardIndex}}"
      bindchange="onFuelCardChange"
      disabled="{{!!resubmitApplicationId || !form.vehicle_id || noCardForVehicle || fuelCardsLoading}}"
    >
      <view class="picker-value">{{fuelCardsLoading ? '油卡加载中...' : (form.vehicle_id ? fuelCardLabels[fuelCardIndex] : '请先选择车辆')}}</view>
    </picker>
    <view wx:if="{{noCardForVehicle}}" class="notice-warning">该车辆尚未配置油卡，请联系办公室</view>

    <view class="label required">申请额度</view>
    <input
      class="input"
      type="digit"
      value="{{form.requested_amount}}"
      data-key="requested_amount"
      bindinput="onInput"
      placeholder="请输入申请额度"
      disabled="{{submitting}}"
    />

    <view class="label required">车辆里程 (km)</view>
    <input
      class="input"
      type="digit"
      value="{{form.vehicle_mileage_km}}"
      data-key="vehicle_mileage_km"
      bindinput="onInput"
      placeholder="请输入当前里程"
      disabled="{{submitting}}"
    />

    <view class="label required">现场照片</view>
    <view class="row">
      <t-button class="btn" variant="outline" bindtap="choosePhotos" disabled="{{submitting}}">上传照片</t-button>
      <t-button class="btn btn-primary" theme="primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || noCardForVehicle || fuelCardsLoading}}">
        {{resubmitApplicationId ? '提交补充资料' : '提交申请'}}
      </t-button>
    </view>
    <button wx:if="{{resubmitApplicationId}}" class="secondary-btn" bindtap="cancelResubmit">
      取消补充
    </button>

    <view wx:if="{{photoList.length === 0}}" class="empty-tip">暂无照片</view>
    <view wx:for="{{photoList}}" wx:key="file_key" class="photo-item">
      <view class="photo-name">{{item.file_name}}</view>
      <view class="photo-size">{{item.file_size_text || '未知大小'}}</view>
      <t-button class="mini-btn" size="small" variant="outline" data-index="{{index}}" bindtap="removePhoto" disabled="{{submitting}}">移除</t-button>
    </view>
  </hy-panel-card>

  <hy-panel-card title="🧾 我的申请记录" subtitle="展示申请时间、状态、处理结果与卡余额">
    <view wx:if="{{myApplications.length === 0}}" class="empty-tip">暂无申请记录</view>
    <view wx:for="{{myApplications}}" wx:key="id" class="record-item">
      <view class="record-title">{{item.application_no}}</view>
      <view class="record-line">车辆：{{item.current_plate_no || '-'}} ｜ 里程：{{item.vehicle_mileage_km}}</view>
      <view class="record-line">额度：{{item.requested_amount}}</view>
      <view class="record-status">状态：{{item.statusLabel}}</view>
      <view wx:if="{{item.risk_summary}}" class="record-line">风险：{{item.risk_summary}}</view>
      <view wx:if="{{item.needs_info_reason}}" class="record-warning">补充说明：{{item.needs_info_reason}}</view>
      <view class="record-line">申请时间：{{item.requested_at}}</view>
      <view class="record-line">处理人：{{item.processedByName}} ｜ 卡余额：{{item.latest_card_balance || '-'}}</view>
      <button
        wx:if="{{item.status === 'needs_info'}}"
        size="mini"
        data-id="{{item.id}}"
        bindtap="startResubmit"
      >
        补充资料
      </button>
    </view>
  </hy-panel-card>
</view>
