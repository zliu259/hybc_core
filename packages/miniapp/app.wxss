@import "miniprogram_npm/tdesign-miniprogram/common/style/index.wxss";

page {
  background: #eef3f8;
  color: #1f2329;
  font-family: PingFang SC, Hiragino Sans GB, sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 140rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.sub {
  font-size: 24rpx;
  color: #5c667a;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn {
  flex: 1;
  min-height: 96rpx;
}

.btn-primary {
  --td-button-primary-bg-color: #1677ff;
  --td-button-primary-border-color: #1677ff;
}

.btn-warn {
  --td-button-danger-bg-color: #d54941;
  --td-button-danger-border-color: #d54941;
}

.btn:active {
  opacity: 0.85;
}

.btn[disabled] {
  opacity: 0.55;
}

.input {
  border: 1px solid #d8dce5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
  background: #fff;
  font-size: 28rpx;
}

.label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5c667a;
}

.required::before {
  content: "* ";
  color: #d54941;
}

.empty-state {
  text-align: center;
  padding: 32rpx;
  color: #8b95a7;
  font-size: 26rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin: 6rpx 0 14rpx;
}

.stats-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(180deg, #f7faff 0%, #eef4ff 100%);
  border-radius: 16rpx;
  padding: 16rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1677ff;
}

.stat-label {
  font-size: 22rpx;
  color: #5c667a;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.entry-card {
  background: #f7fbff;
  border: 1px solid #dbe8f7;
  border-radius: 16rpx;
  padding: 20rpx;
  min-height: 150rpx;
  box-sizing: border-box;
}

.entry-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #5c667a;
  line-height: 1.4;
}

.profile-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.traffic-green {
  color: #17803d;
}

.traffic-yellow {
  color: #b26a00;
}

.traffic-red {
  color: #be2d2d;
}

.kpi-board {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}

.kpi-item {
  border-radius: 18rpx;
  padding: 18rpx;
  background: #fff;
  border: 1px solid #e5ebf2;
}

.kpi-item.red {
  background: #fff2f2;
  border-color: #ffc7c7;
}

.kpi-item.yellow {
  background: #fff8ea;
  border-color: #ffd99a;
}

.kpi-item.green {
  background: #f1fff1;
  border-color: #b7e7c3;
}

.kpi-label {
  font-size: 24rpx;
}

.kpi-value {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.fab-helper {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  bottom: 38rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: radial-gradient(circle at 30% 30%, #5bb4ff, #1677ff 70%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 18rpx 30rpx rgba(22, 119, 255, 0.35);
  color: #fff;
  font-size: 46rpx;
  z-index: 99;
  animation: breath 2.4s infinite;
}

.fab-helper:active {
  opacity: 0.85;
}

@keyframes breath {
  0% {
    transform: translateX(-50%) scale(1);
  }
  50% {
    transform: translateX(-50%) scale(1.06);
  }
  100% {
    transform: translateX(-50%) scale(1);
  }
}
