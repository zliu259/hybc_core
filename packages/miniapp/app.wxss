@import "tdesign-miniprogram/common/style/index.wxss";

page {
  background: #f3f5f8;
  color: #1f2329;
  font-family: PingFang SC, Hiragino Sans GB, sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.sub {
  font-size: 24rpx;
  color: #5c667a;
}

.row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.btn {
  flex: 1;
}

.btn-primary {
  --td-button-primary-bg-color: #1677ff;
  --td-button-primary-border-color: #1677ff;
}

.btn-warn {
  --td-button-danger-bg-color: #d54941;
  --td-button-danger-border-color: #d54941;
}

.btn:active {
  opacity: 0.85;
}

.btn[disabled] {
  opacity: 0.55;
}

.input {
  border: 1px solid #d8dce5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
  background: #fff;
  font-size: 28rpx;
}

.label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5c667a;
}

.required::before {
  content: "* ";
  color: #d54941;
}

.empty-state {
  text-align: center;
  padding: 32rpx;
  color: #8b95a7;
  font-size: 26rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  margin: 6rpx 0 14rpx;
}

.stats-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(180deg, #f7faff 0%, #eef4ff 100%);
  border-radius: 16rpx;
  padding: 16rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1677ff;
}

.stat-label {
  font-size: 22rpx;
  color: #5c667a;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 14rpx;
}
