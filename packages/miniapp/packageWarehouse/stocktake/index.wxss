@import "../common/wh.wxss";

.stocktake-head {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 24rpx;
}

.stocktake-head-main {
  flex: 1;
  min-width: 0;
}

.stocktake-search {
  margin-bottom: 16rpx;
  background: #fff;
}

.stocktake-filter {
  margin-bottom: 24rpx;
}

.stocktake-scan {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stocktake-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2a3d;
}

/* 还没盘的行：数字的位置上写「没盘」，淡一点 */
.stocktake-count-empty {
  font-weight: 400;
  color: #8a94a6;
}

.stocktake-loss {
  color: #d4380d;
}

.stocktake-gain {
  color: #389e0d;
}

.stocktake-book {
  margin-bottom: 24rpx;
}

.stocktake-hint {
  margin-top: 12rpx;
}
