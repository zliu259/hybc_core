/* 审批详情、付款详情共用的卡片样式：凭证头部、键值行、AI 审查、附件、审批流程、骨架屏 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2329;
}

/* 头部：凭证版式 */
.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-label {
  font-size: 26rpx;
  color: #5c667a;
}

.voucher-amount {
  margin-top: 6rpx;
  font-size: 60rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  color: #1f2329;
  word-break: break-all;
}

.voucher-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #5c667a;
}

.voucher-upper {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #1f2329;
  letter-spacing: 2rpx;
  word-break: break-all;
}

.hero-title {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1f6;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #1f2329;
  word-break: break-word;
}

.stop-notice {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fdecea;
  font-size: 26rpx;
  line-height: 1.55;
  color: #b3362e;
  word-break: break-word;
}

/* 取消、撤回：不是谁否决了这笔单子，用中性色 */
.stop-closed {
  background: #eef1f5;
  color: #5c667a;
}

/* 退回（含 AI 拦截退回）非终态，用警示色与终态驳回区分 */
.stop-returned {
  background: #fff4e0;
  color: #8a5300;
}

.hero-foot {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 4rpx 16rpx;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8a94a6;
}

.hero-wait {
  color: #1677ff;
}

.hero-no {
  word-break: break-all;
}

/* 键值行 */
.kv {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 10rpx;
}

.k {
  flex: none;
  width: 150rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #5c667a;
}

.v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.55;
  color: #1f2329;
  word-break: break-word;
}

/* 备注、变更缘由等长文本：保留换行 */
.v-multiline {
  white-space: pre-wrap;
}

/* AI 审查 */
.coverage-alert {
  margin-bottom: 14rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #f0b95b;
  border-radius: 12rpx;
  background: #fff4e0;
}

.coverage-title {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #8a5300;
}

.coverage-row {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: #8a5300;
  word-break: break-word;
}

.ai-summary {
  font-size: 28rpx;
  line-height: 1.6;
  color: #1f2329;
  word-break: break-word;
}

.ai-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5c667a;
  word-break: break-word;
}

.ai-error {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #b3362e;
  word-break: break-word;
}

.finding {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf1f6;
}

.finding-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.finding-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
  word-break: break-word;
}

.finding-text {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #1f2329;
  word-break: break-word;
}

.finding-evidence {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #5c667a;
  word-break: break-word;
}

.finding-warn {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #8a5300;
}

.sub-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #5c667a;
}

.bullet {
  position: relative;
  margin-top: 6rpx;
  padding-left: 22rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #1f2329;
  word-break: break-word;
}

.bullet::before {
  content: "•";
  position: absolute;
  left: 0;
  color: #8a94a6;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.report-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1f2329;
  word-break: break-word;
}

.report-raw {
  margin-top: 12rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
  font-size: 24rpx;
  line-height: 1.6;
  color: #5c667a;
  word-break: break-all;
  white-space: pre-wrap;
}

/* 折叠 */
.fold-link {
  margin-top: 16rpx;
  padding: 6rpx 0;
  font-size: 26rpx;
  color: #1677ff;
}

.fold-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf1f6;
}

.fold-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #1f2329;
}

.fold-action {
  flex: none;
  font-size: 26rpx;
  color: #1677ff;
}

.edit-row {
  margin-top: 12rpx;
}

.edit-meta {
  font-size: 24rpx;
  color: #8a94a6;
}

.edit-note {
  margin-top: 2rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #1f2329;
  word-break: break-word;
}

/* 附件：整行可点 */
.attach-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  border-top: 1rpx solid #edf1f6;
}

.card-head + .attach-row {
  border-top: 0;
}

.attach-ext {
  flex: none;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #eef3f8;
  font-size: 22rpx;
  color: #5c667a;
}

.attach-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  font-size: 26rpx;
  color: #1f2329;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.attach-size {
  flex: none;
  font-size: 24rpx;
  color: #8a94a6;
}

/* 审批流程 */
.round-end {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #5c667a;
  word-break: break-word;
}

.flow-node {
  padding: 14rpx 0;
  border-top: 1rpx solid #edf1f6;
}

.flow-node-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.flow-node-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.flow-task {
  margin-top: 8rpx;
}

.flow-task-line {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #1f2329;
}

.flow-task-action {
  color: #5c667a;
}

.flow-task-time {
  font-size: 24rpx;
  color: #8a94a6;
}

.flow-task-comment {
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #1f2329;
  word-break: break-word;
}

.empty-wrap {
  padding: 40rpx 0;
}

/* 加载骨架屏：贴合卡片外观，流光动画区别于静态文案 */
.skeleton-card {
  padding: 24rpx;
  margin-bottom: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf3;
  border-radius: 18rpx;
}

.skeleton-line {
  height: 26rpx;
  margin-bottom: 18rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #eef1f5 25%, #e0e5ec 37%, #eef1f5 63%);
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.4s ease infinite;
}

.skeleton-line:last-child {
  margin-bottom: 0;
}

.skeleton-title {
  width: 46%;
  height: 32rpx;
}

.skeleton-short {
  width: 62%;
}

.skeleton-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 20rpx 0;
}

.skeleton-hint-text {
  font-size: 24rpx;
  color: #8a94a6;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 100% 50%;
  }

  100% {
    background-position: 0 50%;
  }
}
