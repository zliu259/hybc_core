.sp-field {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 84rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #d8dce5;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.sp-field--hover {
  background: #f7fbff;
}

.sp-field--selected {
  border-color: #1677ff;
  background: #f8fbff;
}

.sp-field--disabled {
  opacity: 0.55;
}

.sp-field__value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sp-field__value--placeholder {
  color: #9aa3b2;
}

.sp-field__primary {
  color: #1f2329;
}

.sp-field__secondary {
  color: #7b8494;
  font-size: 26rpx;
}

.sp-field__icon {
  color: #8b95a7;
}

.sp-field--selected .sp-field__icon {
  color: #1677ff;
}

/* ---- bottom sheet ---- */
.sp-sheet {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.sp-sheet__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 12rpx;
}

.sp-sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2329;
}

.sp-sheet__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #5c667a;
}

.sp-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 8rpx 28rpx 12rpx;
  padding: 14rpx 20rpx;
  background: #f3f5f8;
  border-radius: 14rpx;
}

.sp-search__icon {
  color: #8b95a7;
}

.sp-search__input {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  font-size: 28rpx;
  color: #1f2329;
}

.sp-search__ph {
  color: #9aa3b2;
}

.sp-search__clear {
  color: #b6bdc9;
  padding: 4rpx;
}

.sp-count {
  padding: 0 30rpx 8rpx;
  font-size: 22rpx;
  color: #8b95a7;
}

.sp-list {
  max-height: 56vh;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.sp-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 16rpx;
  border-radius: 14rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.sp-row:last-child {
  border-bottom: none;
}

.sp-row--hover {
  background: #f7fbff;
}

.sp-row--checked {
  background: #eaf3ff;
}

.sp-row__text {
  flex: 1;
  min-width: 0;
}

.sp-row__primary {
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sp-row--checked .sp-row__primary {
  color: #1677ff;
  font-weight: 500;
}

.sp-row__secondary {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #7b8494;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sp-row__check {
  color: #1677ff;
}

.sp-row__chevron {
  color: #c4cbd6;
}

.sp-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 100rpx;
}

.sp-empty__icon {
  color: #d3d8e0;
  margin-bottom: 16rpx;
}

.sp-empty__text {
  font-size: 26rpx;
  color: #9aa3b2;
}

.sp-safe-bottom {
  height: env(safe-area-inset-bottom);
}
