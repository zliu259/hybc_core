.project-picker {
  margin-top: 8rpx;
}

.selected-meta {
  margin-top: 12rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.meta-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e4ebf4;
  background: #f3f5f8;
  color: #5c667a;
  font-size: 22rpx;
}

.meta-status {
  border-color: #cfe1fb;
  background: #eaf3ff;
  color: #1677ff;
}
