<view class="project-picker">
  <view class="label required">{{label}}</view>
  <hy-search-picker
    range="{{projectNames}}"
    value="{{selectedIndex}}"
    title="选择项目"
    placeholder="请选择项目"
    searchPlaceholder="按项目名称 / 拼音 / 首字母搜索"
    emptyText="暂无可选项目"
    disabled="{{loading || !projectNames.length}}"
    hasPlaceholderOption="{{false}}"
    bindchange="onPickerChange"
  />
  <view wx:if="{{hasSelection}}" class="selected-meta">
    <view class="meta-chip">{{selectedProjectCode || "未设置编号"}}</view>
    <view class="meta-chip meta-status">状态：{{selectedProjectStatus || "unknown"}}</view>
  </view>
  <view class="row">
    <t-button class="btn" variant="outline" bindtap="loadProjects" loading="{{loading}}" disabled="{{loading}}">刷新项目</t-button>
    <t-button wx:if="{{enableGps}}" class="btn" variant="outline" bindtap="autoSelectByGps" loading="{{loading}}" disabled="{{loading}}">定位匹配</t-button>
  </view>
  <view class="sub" wx:if="{{autoHint}}">{{autoHint}}</view>
</view>
