<view class="card panel-card">
  <view wx:if="{{title}}" class="panel-title-row">
    <t-icon wx:if="{{icon}}" name="{{icon}}" size="36rpx" color="#1677ff" />
    <view class="panel-title">{{title}}</view>
  </view>
  <view wx:if="{{subtitle}}" class="panel-sub">{{subtitle}}</view>
  <t-divider wx:if="{{divider}}" />
  <slot></slot>
  <slot name="footer"></slot>
</view>
