{
  "name": "@hybc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts --local --persist-to .wrangler/state",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hybcdg-prod-db --local",
    "db:seed:mock:local": "wrangler d1 execute hybcdg-prod-db --local --file ./scripts/mock-data.sql",
    "legacy:fin:gen-mapping": "python3 scripts/legacy_fin_generate_mapping.py",
    "legacy:fin:dry-run": "python3 scripts/legacy_fin_import.py --mode dry-run",
    "legacy:fin:apply:local:base": "python3 scripts/legacy_fin_import.py --mode apply --tables payee,entity",
    "legacy:fin:apply:local": "python3 scripts/legacy_fin_import.py --mode apply",
    "phase3:e2e": "node scripts/phase3-e2e.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check \"src/**/*.ts\" --ignore-unknown"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260129.0",
    "@eslint/js": "^9.39.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.78.0"
  }
}
