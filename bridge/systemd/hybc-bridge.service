[Unit]
Description=HYBC Azure WeCom Bridge
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/hybc_core/bridge
EnvironmentFile=/opt/hybc_core/bridge/.env
ExecStart=/opt/hybc_core/bridge/.venv/bin/uvicorn app.main:app --host ${BRIDGE_HOST} --port ${BRIDGE_PORT} --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
