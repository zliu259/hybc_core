BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=9001

# WeCom callback verification token (same value configured in WeCom callback settings)
WECOM_VERIFY_TOKEN=replace-me

# Worker ingestion endpoint on Cloudflare
WORKER_INGEST_URL=https://api.hybcdg.com/api/v1/system/bridge/wecom-ingest

# HMAC secret shared with Worker ingest endpoint
BRIDGE_HMAC_SECRET=replace-me

# Optional: fixed source tag for audit
BRIDGE_SOURCE=azure_wecom_bridge
BRIDGE_PUBLIC_DOMAIN=bridge.hybcdg.com

# Internal token used by Worker to call /wecom/proxy
BRIDGE_PROXY_TOKEN=replace-me

# Optional: bridge timeout/retry tuning
WORKER_TIMEOUT_SECONDS=10
WORKER_MAX_RETRIES=3
WORKER_API_BASE_URL=https://api.hybcdg.com

# Relay overload protection (for /api/* and /wecom/proxy)
RELAY_MAX_INFLIGHT=120
RELAY_ERROR_WINDOW_SECONDS=60
RELAY_MIN_SAMPLES=10
RELAY_TIMEOUT_RATE_THRESHOLD=0.3
RELAY_ERROR_RATE_THRESHOLD=0.5
RELAY_COOLDOWN_SECONDS=20

# Optional: additional hostnames for HTTPS certificates (comma separated)
BRIDGE_EXTRA_DOMAINS=
